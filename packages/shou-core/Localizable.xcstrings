    "A little setup. More room to breathe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little setup. More room to breathe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备就绪，收拾一下。"
