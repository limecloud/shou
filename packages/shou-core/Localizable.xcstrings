            "value": "The next start will use this exact configuration. Data is not initialized, moved or removed, and no server is started by this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次启动将使用此确切配置。本次操作不会初始化、移动或删除数据，也不会启动服务器。"
          }
        }
      }
    },
    "The official WinGet source could not be verified. Custom sources are not used.": {
