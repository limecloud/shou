        }
      }
    },
    "Age uses the newest modification anywhere inside the target. MB means 1,000,000 allocated bytes; sizes remain estimates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age uses the newest modification anywhere inside the target. MB means 1,000,000 allocated bytes; sizes remain estimates."
