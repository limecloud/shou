          }
        }
      }
    },
    "The selected installation initializes a new private directory. The server stays stopped, listens on loopback when started, and has a password from creation. Existing instances and login registration are unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected installation initializes a new private directory. The server stays stopped, listens on loopback when started, and has a password from creation. Existing instances and login registration are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选安装版本将初始化全新的私有目录。创建后保持停止，启动后仅监听本机，并从创建时设置密码。不改变既有实例或登录启动登记。"
          }
        }
      }
    },
    "The selected items overlap. Choose either a folder or its contents.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected items overlap. Choose either a folder or its contents."
          }
        },
