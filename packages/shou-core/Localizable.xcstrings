        }
      }
    },
    "The registration result needs verification. Refresh its state before continuing; database files were not removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The registration result needs verification. Refresh its state before continuing; database files were not removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登记结果需要核实。请刷新状态后继续；数据库文件未被删除。"
          }
        }
      }
    },
    "The requested state could not be verified. Refresh status before retrying.": {
