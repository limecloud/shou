    "One configuration combines a decision service and an optional main model. Keys are saved locally for your user account; ordinary scans work offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One configuration combines a decision service and an optional main model. Keys are saved locally for your user account; ordinary scans work offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个方案包含决策服务和可选大模型。密钥保存在当前用户的本地私有目录；普通扫描离线运行。"
          }
        }
      }
    },
    "One relative pattern per line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One relative pattern per line"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对路径模式，每行一条"
          }
        }
      }
    },
    "One scan. A tidier Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One scan. A tidier Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描一次，一起收好。"
          }
        }
      }
    },
    "One set of rules for everyday cleanup and your own projects.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One set of rules for everyday cleanup and your own projects."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日常缓存与个人项目，共用一套清理规则。"
          }
        }
      }
    },
    "Only bounded relative metadata and your answers are sent to the disclosed services. File contents are excluded. No automatic deletion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only bounded relative metadata and your answers are sent to the disclosed services. File contents are excluded. No automatic deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅向已披露服务发送限定范围的相对元数据和你的回答，不读取文件正文，不自动删除。"
          }
        }
      }
    },
    "Only explicit cache subdirectories are included. Preserve profiles, credentials, environments and source projects. Close the owning tool before cleanup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only explicit cache subdirectories are included. Preserve profiles, credentials, environments and source projects. Close the owning tool before cleanup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含明确的缓存子目录，保留用户配置、凭据、环境与源代码项目。清理前请关闭所属工具。"
          }
        }
      }
    },
    "Only finished records are removed. Files stay in place; recoverable and unfinished records are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only finished records are removed. Files stay in place; recoverable and unfinished records are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清理已结束的记录，文件保持原位。恢复所需和未结束的记录会保留。"
          }
        }
      }
    },
    "Only global tools configured for latest are eligible. Project versions and lockfiles stay outside this operation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only global tools configured for latest are eligible. Project versions and lockfiles stay outside this operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅升级全局配置为 latest 的工具，不操作项目版本及项目锁文件。"
          }
        }
      }
    },
    "Only in current analysis": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only in current analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当前分析观察到"
          }
        }
      }
    },
    "Only in earlier analysis": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only in earlier analysis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅较早分析观察到"
          }
        }
      }
    },
    "Only measured space is included. Complete folders remain available even when another location cannot be read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only measured space is included. Complete folders remain available even when another location cannot be read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果仅包含已统计的空间。部分位置无法读取，不影响其他完整目录的浏览与审阅。"
          }
        }
      }
    },
    "Only named cache subdirectories in the default Windows user location are included. Close the owning application and stop affected builds first. Profiles, accounts, credentials, sessions, settings, extensions, environments and project sources are retained. Custom locations require separate review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only named cache subdirectories in the default Windows user location are included. Close the owning application and stop affected builds first. Profiles, accounts, credentials, sessions, settings, extensions, environments and project sources are retained. Custom locations require separate review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含默认 Windows 用户位置下明确命名的缓存子目录。请先关闭所属应用并停止相关构建。用户配置、账号、凭据、会话、设置、扩展、环境和项目源码都会保留；自定义位置需单独审阅。"
          }
        }
      }
    },
    "Only named user cache directories are targeted. Documents, preferences and system-owned data are retained.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only named user cache directories are targeted. Documents, preferences and system-owned data are retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅匹配已明确列出的用户缓存目录。保留文稿、偏好设置和系统数据。"
          }
        }
      }
    },
    "Only records are removed. Files stay in place, but Shou can no longer restore or verify these records.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only records are removed. Files stay in place, but Shou can no longer restore or verify these records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除记录，文件保持原位。删除后将无法通过 Shou 恢复或核验这些记录。"
          }
        }
      }
    },
    "Only rule paths are measured, within the discovery depth and scan budget. This is not a full workspace space analysis. Editing any field requires a new preview.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only rule paths are measured, within the discovery depth and scan budget. This is not a full workspace space analysis. Editing any field requires a new preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次仅在发现深度和扫描预算内测量规则路径，不代表整个工作区的空间分析。修改任一字段后需重新预览。"
          }
        }
      }
    },
    "Only the listed application directories and two levels of folders are checked. Embedded apps, package receipts and custom installation locations are not enumerated.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the listed application directories and two levels of folders are checked. Embedded apps, package receipts and custom installation locations are not enumerated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅检查列出的应用目录及其下两层文件夹。不枚举内嵌应用、安装包收据或自定义安装位置。"
          }
        }
      }
    },
    "Only the named directory under the current user's Library/Caches is included. Protected files remain blocked; preferences, personal data and downloaded models outside the cache are retained.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the named directory under the current user's Library/Caches is included. Protected files remain blocked; preferences, personal data and downloaded models outside the cache are retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅包含当前用户 Library/Caches 下的指定目录。受保护文件仍禁止清理，保留偏好设置、个人数据及缓存目录之外的已下载模型。"
          }
        }
      }
    },
    "Only the stopped instance's registration is removed. Its database, configuration and logs stay on disk. This does not free disk space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the stopped instance's registration is removed. Its database, configuration and logs stay on disk. This does not free disk space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除此已停止实例的登记，数据库、配置和日志仍保留在磁盘上。此操作不会释放磁盘空间。"
          }
        }
      }
    },
    "Only the versions shown above are included in this review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the versions shown above are included in this review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次审阅仅包含上方列出的软件和目标版本。"
          }
        }
      }
    },
    "Only this folder and its children are investigated. This does not select files for cleanup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this folder and its children are investigated. This does not select files for cleanup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅调查此目录及其子目录。调查范围不改变清理勾选。"
          }
        }
      }
    },
    "Only this folder is described. The workspace itself and folders outside it cannot be selected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this folder is described. The workspace itself and folders outside it cannot be selected."
