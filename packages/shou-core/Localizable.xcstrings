          "stringUnit": {
            "state": "translated",
            "value": "在“服务”页使用此实例的开关；停止后保留独立数据。"
          }
        }
      }
    },
    "Use your own model service. API keys stay in Keychain; ordinary scans work offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own model service. API keys stay in Keychain; ordinary scans work offline."
