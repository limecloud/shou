            "value": "Use Recommended Selection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用推荐选择"
          }
        }
      }
    },
    "Use Structured Decisions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Structured Decisions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用结构化决策服务"
          }
        }
      }
    },
    "Use a Main Model for Open-ended Understanding": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Main Model for Open-ended Understanding"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用主模型处理开放式理解"
          }
        }
      }
    },
    "Use a decision model and an HTTPS API base URL without credentials. HTTP is allowed only on loopback.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a decision model and an HTTPS API base URL without credentials. HTTP is allowed only on loopback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写决策模型和不含凭据的 HTTPS API 根地址。HTTP 仅支持本机回环地址。"
          }
        }
      }
    },
    "Use a model name and an HTTPS API base URL. HTTP is allowed only on loopback. Do not include credentials or an endpoint suffix in the URL.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a model name and an HTTPS API base URL. HTTP is allowed only on loopback. Do not include credentials or an endpoint suffix in the URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写模型名称和 HTTPS API 基础地址。HTTP 仅限本机回环地址，地址中不可包含凭据或协议端点后缀。"
          }
        }
      }
    },
    "Use a printable search of up to 256 characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a printable search of up to 256 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含控制字符且不超过 256 个字符的搜索内容。"
          }
        }
      }
    },
    "Use an exact relative project directory. Leave the pattern empty to protect the whole project.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an exact relative project directory. Leave the pattern empty to protect the whole project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写确切的项目相对目录。模式留空时保护整个项目。"
          }
        }
      }
    },
    "Use distinct analyses, an exact relative directory, limit 1–100, max-entries 1–100000 and max-seconds 1–30.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use distinct analyses, an exact relative directory, limit 1–100, max-entries 1–100000 and max-seconds 1–30."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择不同的分析及精确的相对目录，结果数为 1–100、检查项目数为 1–100000、用时为 1–30 秒。"
          }
        }
      }
    },
    "Use light, dark, or your system appearance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use light, dark, or your system appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择亮色、暗色或跟随系统设置。"
          }
        }
      }
    },
    "Use relative patterns such as **/target/** or **/keep/**. Absolute paths and parent traversal are not allowed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use relative patterns such as **/target/** or **/keep/**. Absolute paths and parent traversal are not allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 **/target/** 或 **/keep/** 等相对模式。不允许绝对路径或向上访问父目录。"
          }
        }
      }
    },
    "Use static indicators and immediate transitions. Otherwise, follow Windows animation settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use static indicators and immediate transitions. Otherwise, follow Windows animation settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用静态指示与即时切换；关闭时跟随 Windows 动画设置。"
          }
        }
      }
    },
    "Use static indicators and immediate transitions. When off, follow macOS Reduce Motion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use static indicators and immediate transitions. When off, follow macOS Reduce Motion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用静态指示和即时切换；关闭时遵循 macOS 的“减少动态效果”设置。"
          }
        }
      }
    },
    "Use the arrow keys to browse and expand groups. Press Space to change the focused selection, or Shift-F10 for path actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the arrow keys to browse and expand groups. Press Space to change the focused selection, or Shift-F10 for path actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键浏览和展开分类，按空格更改当前项的勾选状态，按 Shift-F10 打开路径操作菜单。"
          }
        }
      }
    },
    "Use this instance's switch on the Service tab. Its data remains separate when stopped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this instance's switch on the Service tab. Its data remains separate when stopped."
