          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先停止相关工具与构建任务。离线工作流可能需要重新下载。保留已安装工具、凭据、配置和项目源码；受保护的后代内容仍会阻止清理。"
          }
        }
      }
