    "Use an exact relative project directory. Leave the pattern empty to protect the whole project.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an exact relative project directory. Leave the pattern empty to protect the whole project."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写确切的项目相对目录。模式留空时保护整个项目。"
          }
        }
      }
    },
    "Use light, dark, or your system appearance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use light, dark, or your system appearance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择亮色、暗色或跟随系统设置。"
          }
        }
      }
    },
    "Use relative patterns such as **/target/** or **/keep/**. Absolute paths and parent traversal are not allowed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use relative patterns such as **/target/** or **/keep/**. Absolute paths and parent traversal are not allowed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 **/target/** 或 **/keep/** 等相对模式。不允许绝对路径或向上访问父目录。"
          }
        }
      }
    },
    "Use static indicators and immediate transitions. When off, follow macOS Reduce Motion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use static indicators and immediate transitions. When off, follow macOS Reduce Motion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用静态指示和即时切换；关闭时遵循 macOS 的“减少动态效果”设置。"
          }
        }
      }
    },
    "Use the arrow keys to browse and expand groups. Press Space to change the focused selection, or Shift-F10 for path actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the arrow keys to browse and expand groups. Press Space to change the focused selection, or Shift-F10 for path actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键浏览和展开分类，按空格更改当前项的勾选状态，按 Shift-F10 打开路径操作菜单。"
          }
        }
