    "The package inventory is incomplete. Refresh it before selecting updates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package inventory is incomplete. Refresh it before selecting updates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件包盘点不完整，请刷新后再选择更新。"
          }
        }
      }
    },
    "The package manager could not check available versions. Installed packages are shown without upgrade eligibility.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package manager could not check available versions. Installed packages are shown without upgrade eligibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器未能完成版本检查。当前仅显示已安装内容，暂不能升级。"
          }
        }
      }
    },
    "The package manager could not finish. Open the owning tool or check again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package manager could not finish. Open the owning tool or check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器未能完成操作，请打开对应工具检查，或重新检查。"
          }
        }
      }
    },
    "The package manager is not installed in a supported location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package manager is not installed in a supported location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未在支持的位置找到此包管理器。"
          }
        }
      }
    },
    "The package manager is working. Shou will wait for its result before closing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package manager is working. Shou will wait for its result before closing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器正在执行。Shou 会等待当前任务返回真实结果后再关闭。"
          }
        }
      }
    },
    "The package manager may download files, run installation scripts and change dependencies. Close affected apps and save your work. Shou will not automatically accept agreements, request an administrator password, or restart the computer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package manager may download files, run installation scripts and change dependencies. Close affected apps and save your work. Shou will not automatically accept agreements, request an administrator password, or restart the computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器可能下载文件、运行安装脚本并更改依赖。请先保存工作并关闭相关应用。Shou 不会自动同意协议、请求管理员密码或重启电脑。"
          }
        }
      }
    },
    "The package manager may have changed files. Inspect the source before trying again; Shou will not retry automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package manager may have changed files. Inspect the source before trying again; Shou will not retry automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器可能已经修改文件。请重新检查来源再尝试，Shou 不会自动重试。"
          }
        }
      }
    },
    "The package manager needs permissions that Shou cannot request. Open the owning tool to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package manager needs permissions that Shou cannot request. Open the owning tool to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器需要额外权限，请打开对应工具继续。"
          }
        }
      }
    },
    "The packaged CLI is unavailable. Install Shou in Applications first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The packaged CLI is unavailable. Install Shou in Applications first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到应用内的 CLI，请先将 Shou 安装到应用程序。"
          }
        }
      }
    },
    "The page could not be loaded. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page could not be loaded. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面无法加载，请重试。"
          }
        }
      }
    },
    "The previous source used an unknown portion of the scan budget.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous source used an unknown portion of the scan budget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定上一个来源已消耗的扫描预算。"
          }
        }
      }
    },
    "The project's build tool can recreate generated distribution outputs when the build inputs remain available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project's build tool can recreate generated distribution outputs when the build inputs remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在构建所需的输入仍然可用时，项目构建工具可以重新生成发布产物。"
          }
        }
      }
    },
    "The read worker could not be started.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read worker could not be started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动扫描，请重试。"
