          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地密钥由用户文件权限保护，不使用钥匙串加密；不会写入连接资料或调查历史。连接测试仅发送合成数据。"
          }
        }
      }
    },
