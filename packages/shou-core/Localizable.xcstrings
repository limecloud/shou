    "1. Copy the request to Codex, Claude Code, or WorkBuddy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Copy the request to Codex, Claude Code, or WorkBuddy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 复制请求，交给已有的 Codex、Claude Code 或 WorkBuddy。"
          }
        }
      }
    },
    "2. Answer questions about your projects and what to keep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Answer questions about your projects and what to keep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 回答项目用途、重建方式和保留项等必要问题。"
          }
        }
      }
    },
    "3. Review the draft in Shou, then enable it when ready.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Review and enable the rule once. Future cleanups include it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 确认并启用规则一次，后续清理自动包含。"
          }
        }
      }
    },
    "A built-in scan location has no scoped rules.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A built-in scan location has no scoped rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置扫描位置没有适用的清理规则。"
          }
        }
      }
    },
    "A complete directory manifest is required before moving to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete directory manifest is required before moving to Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓前必须取得完整目录清单。"
          }
        }
      }
    },
    "A file or folder was modified too recently": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file or folder was modified too recently"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录或其内部文件近期有修改"
          }
