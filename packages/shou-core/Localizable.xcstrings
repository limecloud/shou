    "1. Copy the request to Codex, Claude Code, or WorkBuddy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Copy the request to Codex, Claude Code, or WorkBuddy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 复制请求，交给已有的 Codex、Claude Code 或 WorkBuddy。"
          }
        }
      }
    },
    "2. Answer questions about your projects and what to keep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Answer questions about your projects and what to keep."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 回答项目用途、重建方式和保留项等必要问题。"
          }
        }
      }
    },
    "3. Review the draft in Shou, then enable it when ready.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Review and enable the rule once. Future cleanups include it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 确认并启用规则一次，后续清理自动包含。"
          }
        }
      }
    },
    "4. Clean selected rules, then verify the result and retained items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Clean selected rules, then verify the result and retained items."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 清理所选规则，核验结果与保留项。"
          }
        }
      }
    },
    "A LITTLE LIGHTER. A LOT MORE ROOM.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A LITTLE LIGHTER. A LOT MORE ROOM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少一点堆积，多一点自在"
          }
        }
      }
    },
    "A built-in scan location has no scoped rules.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A built-in scan location has no scoped rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置扫描位置没有适用的清理规则。"
          }
        }
      }
    },
    "A calmer start.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calmer start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次开机，轻装出发。"
          }
        }
      }
    },
    "A clearer view of apps and build outputs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clearer view of apps and build outputs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用与构建产物，按对象梳理。"
          }
        }
      }
    },
    "A complete directory manifest is required before moving to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complete directory manifest is required before moving to Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓前必须取得完整目录清单。"
          }
        }
      }
    },
    "A decision confidence is not a guarantee of safe deletion. Rule preview and your confirmation are still required.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A decision confidence is not a guarantee of safe deletion. Rule preview and your confirmation are still required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "判断置信度不能保证删除无损，仍需预览规则并由你确认。"
          }
        }
      }
    },
    "A file or folder was modified too recently": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file or folder was modified too recently"
          }
