    "A maintained rule already defines this cache scope; scan again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A maintained rule already defines this cache scope; scan again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置维护规则已定义此缓存范围，请重新扫描。"
          }
        }
      }
    },
    "A preset requires a name and explicit rules.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preset requires a name and explicit rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设需要名称及明确选择的规则。"
          }
        }
      }
    },
    "A project marker must be an exact ordinary filename in the target's parent, such as package.json. Links do not count.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project marker must be an exact ordinary filename in the target's parent, such as package.json. Links do not count."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目标记必须是目标父目录中的普通文件名，例如 package.json；符号链接不作为标记。"
          }
        }
      }
    },
    "A read-only system tool could not verify artifact evidence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A read-only system tool could not verify artifact evidence."
