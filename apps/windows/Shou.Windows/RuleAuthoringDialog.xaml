<Window x:Class="Shou.Windows.RuleAuthoringDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800" Height="780" MinWidth="600" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="LoadedEditor" Closing="ClosingEditor">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" />
    <TextBlock x:Name="WorkspacePath" Grid.Row="1" Margin="0,8,0,16" FontFamily="Consolas" TextWrapping="Wrap" />
    <Grid x:Name="Wizard" Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock x:Name="Steps" FontWeight="SemiBold" Margin="0,0,0,14" AutomationProperties.AutomationId="rules.wizard.steps" />
      <ScrollViewer x:Name="ScopePage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ScopeFields">
          <TextBlock Text="规则名称" /><TextBox x:Name="RuleName" MaxLength="120" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="规则名称" AutomationProperties.AutomationId="rules.wizard.name" />
          <TextBlock Text="选择范围" />
          <ComboBox x:Name="TargetMode" SelectedIndex="0" Margin="0,4,0,14" SelectionChanged="DraftChanged" AutomationProperties.Name="选择范围">
            <ComboBoxItem Content="一个确切目录" /><ComboBoxItem Content="相对路径模式" />
          </ComboBox>
          <TextBlock x:Name="TargetLabel" Text="工作区内的目录（相对路径或完整路径）" />
          <DockPanel Margin="0,4,0,8"><Button x:Name="ChooseTarget" DockPanel.Dock="Right" Content="选择目录…" Click="ChooseTargetFolder" /><TextBox x:Name="Targets" MaxLength="32768" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" FontFamily="Consolas" AutomationProperties.Name="目标目录或相对模式" AutomationProperties.AutomationId="rules.wizard.targets" /></DockPanel>
          <TextBlock Text="只描述所选工作区内的目录。模式每行一个，例如 **/.build-cache；工作区本身、外部目录和链接不会因此获得清理权限。" Opacity="0.7" Margin="0,0,0,14" />
          <TextBlock Text="父目录中的项目标记（可选，每行一个确切文件名）" /><TextBox x:Name="Markers" MaxLength="4096" AcceptsReturn="True" MinHeight="48" MaxHeight="100" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="项目标记" />
          <TextBlock Text="最大发现深度（1–32）" /><TextBox x:Name="Depth" Text="8" MaxLength="2" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="最大发现深度" />
          <TextBlock Text="项目标记必须是目标父目录中的普通文件，例如 package.json；符号链接不算标记。" Opacity="0.7" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ConditionsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel x:Name="ConditionFields">
          <TextBlock Text="最小磁盘占用（MB，0 表示不设下限）" /><TextBox x:Name="MinimumMB" Text="100" MaxLength="13" Margin="0,4,0,12" TextChanged="DraftChanged" AutomationProperties.Name="最小磁盘占用 MB" />
          <CheckBox x:Name="UseAge" Content="保留最近修改过的内容" IsChecked="True" Checked="DraftChanged" Unchecked="DraftChanged" Margin="0,0,0,8" />
          <TextBlock Text="距最新修改的天数（0–3650）" /><TextBox x:Name="Age" Text="14" MaxLength="4" Margin="0,4,0,8" TextChanged="DraftChanged" AutomationProperties.Name="距最新修改的天数" />
          <TextBlock Text="时间条件检查整个目标内的最新修改。1 MB 为 1,000,000 个实际分配字节，占用仍为估算。" Opacity="0.7" Margin="0,0,0,14" />
          <TextBlock Text="相对于工作区的保留模式（可选，每行一个）" /><TextBox x:Name="Exclusions" MaxLength="131072" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" TextChanged="DraftChanged" FontFamily="Consolas" AutomationProperties.Name="保留模式" />
          <TextBlock Text="例如 project/.build-cache/keep/**。保留子项会阻止整个父目标清理；全局和工作区保护始终生效。" Opacity="0.7" Margin="0,0,0,14" />
          <TextBlock Text="如何重新生成这些文件？" /><TextBox x:Name="Rebuild" MaxLength="2000" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="重新生成方式" />
          <TextBlock Text="限制和需要保留的数据（每行一条）" /><TextBox x:Name="Limitations" MaxLength="16000" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="限制和保留数据" />
          <CheckBox x:Name="HighRisk" Content="高风险（已安装依赖必须标记为高风险）" Checked="DraftChanged" Unchecked="DraftChanged" />
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="PreviewPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="只读预览不能删除文件或生成可执行清理计划。修改任何字段后都必须重新预览。" Margin="0,0,0,10" />
        <TextBlock x:Name="PreviewSummary" Grid.Row="1" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.AutomationId="rules.wizard.summary" />
        <DataGrid x:Name="PreviewRows" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" SelectionMode="Single" AutomationProperties.Name="规则只读预览">
          <DataGrid.Columns><DataGridTextColumn Header="目录" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="估计占用" Binding="{Binding Size}" Width="110" /><DataGridTextColumn Header="条件与保护" Binding="{Binding Decision}" Width="220" /></DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding SelectedItem.Decision,ElementName=PreviewRows}" Margin="0,8,0,0" />
        <Expander Grid.Row="4" Header="覆盖范围与限制" Margin="0,8,0,0"><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Coverage" /></ScrollViewer></Expander>
      </Grid>
    </Grid>
    <Grid x:Name="Revision" Grid.Row="2" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock Text="编辑完整 JSON。保留原规则 ID，并选择未使用过的版本；现有版本和绑定不会被覆盖。" Margin="0,0,0,12" />
      <TextBox x:Name="RuleJson" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" MaxLength="262144" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="DraftChanged" AutomationProperties.Name="规则 JSON" AutomationProperties.AutomationId="rules.revision.json" />
    </Grid>
    <ScrollViewer Grid.Row="3" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><TextBlock x:Name="Issue" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" AutomationProperties.LiveSetting="Polite" /></ScrollViewer>
    <TextBlock Grid.Row="4" Text="保存后仍为停用草稿。返回规则页逐条预览、启用并重新扫描，再确认实际清理。" Opacity="0.7" Margin="0,12,0,16" />
    <DockPanel Grid.Row="5">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="取消" IsCancel="True" /><Button x:Name="StopButton" Content="停止预览" Click="Stop" Visibility="Collapsed" /></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Content="上一步" Click="Back" Visibility="Collapsed" />
        <Button x:Name="PreviewAgainButton" Content="重新预览" Click="PreviewAgain" Visibility="Collapsed" />
        <Button x:Name="ValidateButton" Content="校验规则" Click="Validate" Visibility="Collapsed" AutomationProperties.AutomationId="rules.revision.validate" />
        <Button x:Name="NextButton" Content="继续" Click="Next" />
        <Button x:Name="SaveButton" Content="保存草稿" Click="Save" IsEnabled="False" AutomationProperties.AutomationId="rules.authoring.save" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
