<Window x:Class="Shou.Windows.RuleAuthoringDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Shou.Windows"
        Width="800" Height="780" MinWidth="600" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="LoadedEditor" Closing="ClosingEditor">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" />
    <TextBlock x:Name="WorkspacePath" Grid.Row="1" Margin="0,8,0,16" FontFamily="Consolas" TextWrapping="Wrap" />
    <Grid x:Name="Wizard" Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock x:Name="Steps" FontWeight="SemiBold" Margin="0,0,0,14" AutomationProperties.AutomationId="rules.wizard.steps" />
      <ScrollViewer x:Name="ScopePage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ScopeFields">
          <TextBlock Text="{local:Text t18dba51b47c819c5}" /><TextBox x:Name="RuleName" MaxLength="120" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text t18dba51b47c819c5}" AutomationProperties.AutomationId="rules.wizard.name" />
          <TextBlock Text="{local:Text td397ba0e36ed65d9}" />
          <ComboBox x:Name="TargetMode" SelectedIndex="0" Margin="0,4,0,14" SelectionChanged="DraftChanged" AutomationProperties.Name="{local:Text td397ba0e36ed65d9}">
            <ComboBoxItem Content="{local:Text t54508912f5ea57dd}" /><ComboBoxItem Content="{local:Text t78ed660c427f4fee}" />
          </ComboBox>
          <TextBlock x:Name="TargetLabel" Text="{local:Text tc3d590a62599ee0c}" />
          <DockPanel Margin="0,4,0,8"><Button x:Name="ChooseTarget" DockPanel.Dock="Right" Content="{local:Text te7f468a900163753}" Click="ChooseTargetFolder" /><TextBox x:Name="Targets" MaxLength="32768" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" FontFamily="Consolas" AutomationProperties.Name="{local:Text t87f0a14978d40a41}" AutomationProperties.AutomationId="rules.wizard.targets" /></DockPanel>
          <TextBlock Text="{local:Text t5afd219de12496d4}" Opacity="0.7" Margin="0,0,0,14" />
          <TextBlock Text="{local:Text t8570f27f0a96f4ba}" /><TextBox x:Name="Markers" MaxLength="4096" AcceptsReturn="True" MinHeight="48" MaxHeight="100" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text t66c955a0e8a95ae9}" />
          <TextBlock Text="{local:Text t6c911b1c0996bff4}" /><TextBox x:Name="Depth" Text="8" MaxLength="2" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text tfb12d55894925700}" />
          <TextBlock Text="{local:Text t91c491082037a087}" Opacity="0.7" />
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="ConditionsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel x:Name="ConditionFields">
          <TextBlock Text="{local:Text t6af564535caddcab}" /><TextBox x:Name="MinimumMB" Text="100" MaxLength="13" Margin="0,4,0,12" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text t2cdf0e94cc946558}" />
          <CheckBox x:Name="UseAge" Content="{local:Text ta871714e0239491d}" IsChecked="True" Checked="DraftChanged" Unchecked="DraftChanged" Margin="0,0,0,8" />
          <TextBlock Text="{local:Text t822caf9c43f69550}" /><TextBox x:Name="Age" Text="14" MaxLength="4" Margin="0,4,0,8" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text t0d04dde5491f6829}" />
          <TextBlock Text="{local:Text tac37576a0657373c}" Opacity="0.7" Margin="0,0,0,14" />
          <TextBlock Text="{local:Text ta340c5d7fd62ff16}" /><TextBox x:Name="Exclusions" MaxLength="131072" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" TextChanged="DraftChanged" FontFamily="Consolas" AutomationProperties.Name="{local:Text t1f091a934042441e}" />
          <TextBlock Text="{local:Text t3c029db28b477f5e}" Opacity="0.7" Margin="0,0,0,14" />
          <TextBlock Text="{local:Text t436796139cf2bba9}" /><TextBox x:Name="Rebuild" MaxLength="2000" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text t5664aece2478df65}" />
          <TextBlock Text="{local:Text te8e690fc91c767d5}" /><TextBox x:Name="Limitations" MaxLength="16000" AcceptsReturn="True" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,4,0,14" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text t51a5125425c195d6}" />
          <CheckBox x:Name="HighRisk" Content="{local:Text t2af0989f7be60233}" Checked="DraftChanged" Unchecked="DraftChanged" />
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="PreviewPage" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{local:Text t4b485bd6ee4a59eb}" Margin="0,0,0,10" />
        <TextBlock x:Name="PreviewSummary" Grid.Row="1" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.AutomationId="rules.wizard.summary" />
        <DataGrid x:Name="PreviewRows" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" SelectionMode="Single" AutomationProperties.Name="{local:Text tdf93f1119c9c12ce}">
          <DataGrid.Columns><DataGridTextColumn Header="{local:Text t52daa71ebc310581}" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="{local:Text te653ae34f1a1e771}" Binding="{Binding Size}" Width="110" /><DataGridTextColumn Header="{local:Text t22cb4f5c4cecdf54}" Binding="{Binding Decision}" Width="220" /></DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="{Binding SelectedItem.Decision,ElementName=PreviewRows}" Margin="0,8,0,0" />
        <Expander Grid.Row="4" Header="{local:Text t14a7c343def11d7a}" Margin="0,8,0,0"><ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Coverage" /></ScrollViewer></Expander>
      </Grid>
    </Grid>
    <Grid x:Name="Revision" Grid.Row="2" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock Text="{local:Text t5d01dfa858e128a6}" Margin="0,0,0,12" />
      <TextBox x:Name="RuleJson" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" MaxLength="262144" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextChanged="DraftChanged" AutomationProperties.Name="{local:Text t13cb2e3420a5ae3c}" AutomationProperties.AutomationId="rules.revision.json" />
    </Grid>
    <ScrollViewer Grid.Row="3" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><TextBlock x:Name="Issue" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" AutomationProperties.LiveSetting="Polite" /></ScrollViewer>
    <TextBlock Grid.Row="4" Text="{local:Text tb40444f69246ffc2}" Opacity="0.7" Margin="0,12,0,16" />
    <DockPanel Grid.Row="5">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="{local:Text t2cd0f3be8738a86c}" IsCancel="True" /><Button x:Name="StopButton" Content="{local:Text td67e122959534dc5}" Click="Stop" Visibility="Collapsed" /></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Content="{local:Text tda336fdc0dbd1818}" Click="Back" Visibility="Collapsed" />
        <Button x:Name="PreviewAgainButton" Content="{local:Text t088badb8c6f67385}" Click="PreviewAgain" Visibility="Collapsed" />
        <Button x:Name="ValidateButton" Content="{local:Text tdc276660650d47d0}" Click="Validate" Visibility="Collapsed" AutomationProperties.AutomationId="rules.revision.validate" />
        <Button x:Name="NextButton" Content="{local:Text t7c9691192f1b7340}" Click="Next" />
        <Button x:Name="SaveButton" Content="{local:Text t5329e3f0ee463df5}" Click="Save" IsEnabled="False" AutomationProperties.AutomationId="rules.authoring.save" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
