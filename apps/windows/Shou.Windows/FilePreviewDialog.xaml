<Window x:Class="Shou.Windows.FilePreviewDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="只读预览" Width="860" Height="650" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock x:Name="FileNameLabel" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBox x:Name="FilePathLabel" Grid.Row="1" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" Margin="0,8" />
    <StackPanel Grid.Row="2" Margin="0,0,0,10"><TextBlock x:Name="FileFacts" TextWrapping="Wrap" /><TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" Margin="0,6,0,0" /><ProgressBar x:Name="ReadingProgress" IsIndeterminate="True" Height="3" Margin="0,8,0,0" /></StackPanel>
    <Grid Grid.Row="3"><TextBox x:Name="TextPreview" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="文件文本只读预览" /><ScrollViewer x:Name="ImageContainer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><Image x:Name="ImagePreview" Stretch="Uniform" MaxWidth="1600" MaxHeight="1600" AutomationProperties.Name="文件图片只读预览" /></ScrollViewer></Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="复制路径" Click="CopyPathClicked" /><Button Content="关闭" IsCancel="True" IsDefault="True" /></StackPanel>
  </Grid>
</Window>
