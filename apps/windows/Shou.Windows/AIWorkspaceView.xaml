<UserControl x:Class="Shou.Windows.AIWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen" /></UserControl.Resources>
  <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="260" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" MinWidth="300" /></Grid.ColumnDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="AI 调查" FontSize="24" FontWeight="SemiBold" />
      <CheckBox Content="启用 AI 调查" IsChecked="{Binding AiEnabled}" Margin="0,16,0,8" AutomationProperties.Name="启用 AI 调查" />
      <TextBlock Text="开启后仍需点击开始。关闭会停止后续请求。空间占用解释使用本地索引。" Opacity="0.75" />
      <TextBlock Text="连接" Margin="0,20,0,6" />
      <ComboBox ItemsSource="{Binding AiConnections}" SelectedItem="{Binding SelectedAiConnection}" DisplayMemberPath="Name" AutomationProperties.Name="AI 连接" />
      <WrapPanel Margin="0,8,0,0"><Button Content="添加…" Command="{Binding AiNewConnectionCommand}" /><Button Content="编辑…" Command="{Binding AiEditConnectionCommand}" /><Button Content="测试" Command="{Binding AiTestCommand}" ToolTip="仅发送合成数据，不读取文件。" /></WrapPanel>
      <TextBlock Text="{Binding AiConnectionDisclosure}" Margin="0,12,0,0" TextWrapping="Wrap" />
      <StackPanel IsEnabled="{Binding AiCanEdit}">
        <TextBlock Text="目标" Margin="0,20,0,6" /><ComboBox ItemsSource="{Binding AiGoals}" SelectedItem="{Binding SelectedAiGoal}" DisplayMemberPath="Name" AutomationProperties.Name="AI 调查目标" />
        <TextBlock Text="所选物理目录" Margin="0,14,0,6" /><TextBox Text="{Binding AiFolder,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="AI 调查目录" />
        <Button Content="选择目录…" Command="{Binding AiChooseFolderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
        <TextBlock Text="{Binding AiMeasurement}" Margin="0,8,0,0" Opacity="0.75" />
        <TextBlock Text="保留条件与调查要求（可选）" Margin="0,16,0,6" /><TextBox Text="{Binding AiRequest,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxLength="2000" AutomationProperties.Name="保留条件与调查要求" />
      </StackPanel>
      <WrapPanel Margin="0,16,0,0"><Button Content="开始调查" Command="{Binding AiStartCommand}" /><Button Content="停止" Command="{Binding AiStopCommand}" /><Button Content="新建调查" Command="{Binding AiNewCommand}" ToolTip="停止等待中的调查，并清空本次输入与结果。" /></WrapPanel>
      <TextBlock Text="本地调查记录" Margin="0,24,0,6" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding AiHistory}" SelectedItem="{Binding SelectedAiHistory}" DisplayMemberPath="Label" AutomationProperties.Name="已保存的 AI 调查" /><Button Content="打开所选记录" Command="{Binding AiLoadCommand}" HorizontalAlignment="Left" Margin="0,8,0,16" />
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding AiBusy,Converter={StaticResource VisibleWhen}}" Margin="0,0,0,12" />
      <TextBlock Text="{Binding AiStatus}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding AiSummary}" Margin="0,16,0,0" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding AiQuestions}" Margin="0,16,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,16">
        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Answer,Mode=TwoWay}" AutomationProperties.Name="建议的回答" Margin="0,8,0,6" />
        <TextBox Text="{Binding Answer,UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.Name="补充或修改调查回答" />
      </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button Content="提交回答并继续" Command="{Binding AiResumeCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="建议逐条导入为停用草稿。预览、启用并重新扫描后，仍需确认具体文件才能清理。" Margin="0,24,0,8" Opacity="0.75" />
      <ItemsControl ItemsSource="{Binding AiAdvice}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="{Binding Path}" FontWeight="SemiBold" /><TextBlock Text="{Binding Explanation}" Margin="0,6,0,0" /><TextBlock Text="{Binding Conditions}" Margin="0,6,0,12" Opacity="0.8" />
        <Button Content="导入这一条并预览" Command="{Binding DataContext.AiPreviewCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander Header="结构化决策结果" Margin="0,14,0,0"><TextBox Text="{Binding AiDecisions,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,8" /></Expander>
      <Expander Header="服务用量与升级原因" Margin="0,14,0,0"><TextBox Text="{Binding AiUsage,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,8" /></Expander>
      <Expander Header="原调查范围与已观察证据" Margin="0,12,0,20"><TextBox Text="{Binding AiEvidence,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,8" /></Expander>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
