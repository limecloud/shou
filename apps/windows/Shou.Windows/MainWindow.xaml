<Window x:Class="Shou.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shou · 收拾一下" Width="1120" Height="760" MinWidth="840" MinHeight="580" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <Grid>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="收拾一下" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="收好，就好。" Opacity="0.65" Margin="0,5,0,0" /></StackPanel>
      <Button Grid.Column="1" Content="停止当前操作" Command="{Binding CancelCommand}" VerticalAlignment="Center" />
    </Grid>
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSection, Mode=TwoWay}">
      <TabItem Header="清理">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel><Button DockPanel.Dock="Right" Content="选择目录…" Command="{Binding ChooseFolderCommand}" /><ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Path" MinWidth="300" AutomationProperties.Name="扫描目录" /></DockPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14"><Button Content="扫描" Command="{Binding ScanCommand}" /><Button Content="加载更多" Command="{Binding MoreCommand}" /><TextBlock Text="勾选项目，选择清理方式并审阅。永久删除无法恢复。" VerticalAlignment="Center" /></StackPanel>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" IsReadOnly="False" SelectionMode="Extended" AutomationProperties.Name="清理候选项目">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Eligible}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="选择清理项目" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" IsReadOnly="True" /><DataGridTextColumn Header="占用估算" Binding="{Binding Size}" Width="110" IsReadOnly="True" /><DataGridTextColumn Header="风险与原因" Binding="{Binding Description}" Width="260" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="移入回收站…" Command="{Binding CleanCommand}" /><Button Content="永久删除…" Command="{Binding PermanentDeleteCommand}" /></StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="空间分析">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><Button Content="选择目录并分析…" Command="{Binding AnalyzeCommand}" /><Button Content="返回上层" Command="{Binding StorageUpCommand}" /></StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding StoragePath}" Margin="0,12" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding StorageNodes}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" SelectedItem="{Binding SelectedStorageNode}" MouseDoubleClick="OpenStorageNode">
            <DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="占用估算" Binding="{Binding Size}" Width="140" /><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110" /></DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Header="规则与排除">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="110" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal"><Button Content="导入规则草稿…" Command="{Binding ImportRuleCommand}" /><Button Content="启用所选规则" Command="{Binding EnableRuleCommand}" /><Button Content="停用所选规则" Command="{Binding DisableRuleCommand}" /></StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Title" Margin="0,14" AutomationProperties.Name="当前目录规则" />
          <DockPanel Grid.Row="2"><Button DockPanel.Dock="Right" Content="添加全局排除" Command="{Binding AddExclusionCommand}" /><TextBox Text="{Binding ExclusionPattern, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" AutomationProperties.Name="全局排除模式" /></DockPanel>
          <ListBox Grid.Row="3" ItemsSource="{Binding Exclusions}" SelectedItem="{Binding SelectedExclusion}" Margin="0,12,0,0" AutomationProperties.Name="已配置的全局排除" />
          <Button Grid.Row="4" Content="移除所选排除" Command="{Binding RemoveExclusionCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />
        </Grid>
      </TabItem>
      <TabItem Header="历史与恢复">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="180" /></Grid.RowDefinitions>
          <WrapPanel><Button Content="刷新历史" Command="{Binding HistoryCommand}" /><Button Content="恢复所选记录的可恢复项目…" Command="{Binding RestoreCommand}" /><Button Content="永久删除所选记录的回收站项目…" Command="{Binding PurgeCommand}" /></WrapPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" Margin="0,14,0,0">
            <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="190" /><DataGridTextColumn Header="目录" Binding="{Binding RootPath}" Width="*" /><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="140" /></DataGrid.Columns>
          </DataGrid>
          <DataGrid Grid.Row="2" ItemsSource="{Binding HistoryItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" Margin="0,12,0,0" AutomationProperties.Name="所选历史记录的逐项结果">
            <DataGrid.Columns><DataGridTextColumn Header="原始路径" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="130" /><DataGridTextColumn Header="实际结果路径" Binding="{Binding ResultingPath}" Width="220" /><DataGridTextColumn Header="原因" Binding="{Binding Error}" Width="220" /></DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" /><TextBlock Text="{Binding Status}" Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite" /></StackPanel>
  </Grid>
  <Border Visibility="{Binding CompletionVisible, Converter={StaticResource BoolToVisibility}}" Background="#AA0B172A" Padding="28" AutomationProperties.Name="清理完成结果">
    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" CornerRadius="16" Padding="34" MaxWidth="720" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Completion.Icon}" FontSize="56" HorizontalAlignment="Center" Foreground="#2E7D32" />
        <TextBlock Grid.Row="1" Text="{Binding Completion.Title}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock Grid.Row="2" Text="{Binding Completion.SuccessText}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0" />
        <TextBlock Grid.Row="3" Text="{Binding Completion.Message}" Opacity="0.7" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,18" />
        <StackPanel Grid.Row="4">
          <UniformGrid Columns="4" Margin="0,0,0,12" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.Processed}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="已处理" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.Skipped}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="已跳过" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.Failed}" FontSize="20" FontWeight="SemiBold" Foreground="#C62828" HorizontalAlignment="Center" /><TextBlock Text="失败项" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.NeedsVerification}" FontSize="20" FontWeight="SemiBold" Foreground="#EF6C00" HorizontalAlignment="Center" /><TextBlock Text="需核实" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
          </UniformGrid>
          <Expander Header="查看详情" IsExpanded="False" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding Completion.Items}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
                  <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding State}" Opacity="0.75" />
                  <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" />
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </Expander>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
          <Button Content="重新扫描" Command="{Binding RetryCleanupCommand}" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
          <Button Content="查看操作记录" Command="{Binding ViewHistoryFromCompletionCommand}" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
          <Button Content="完成" Command="{Binding DismissCompletionCommand}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Border>
  </Grid>
</Window>
