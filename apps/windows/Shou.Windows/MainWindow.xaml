<Window x:Class="Shou.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Shou.Windows"
        Title="Shou · 收拾一下" Width="1120" Height="760" MinWidth="840" MinHeight="580" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <Grid>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl SelectedIndex="{Binding SelectedSection, Mode=TwoWay}">
      <TabItem Header="清理">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel><Button DockPanel.Dock="Right" Content="扫描范围…" Command="{Binding ShowScanLocationsCommand}" /><Button DockPanel.Dock="Right" Content="选择目录…" Command="{Binding ChooseFolderCommand}" /><ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Path" MinWidth="300" AutomationProperties.Name="扫描目录" /></DockPanel>
          <StackPanel Grid.Row="1" Margin="0,12">
            <WrapPanel><Button Content="一键扫描" Command="{Binding ScanCommand}" /><Button Content="AI 调查…" Command="{Binding AiFromCleanupCommand}" /><Button Content="扫描所选目录" Command="{Binding ScanFolderCommand}" /><Button Content="选择推荐项" Command="{Binding SelectRecommendedCleanupCommand}" /><Button Content="全选当前范围 / 取消" Command="{Binding SelectAllCommand}" /><Button Content="清空选择" Command="{Binding ClearCleanupSelectionCommand}" /></WrapPanel>
            <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="搜索" Command="{Binding ApplyCleanupSearchCommand}" /><TextBox Text="{Binding CleanupQuery,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="搜索清理目录、规则和保护原因"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ApplyCleanupSearchCommand}" /></TextBox.InputBindings></TextBox></DockPanel>
            <TextBlock Text="{Binding CleanupResultSummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="190" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DockPanel><Button DockPanel.Dock="Top" Content="显示全部分类" Command="{Binding ShowAllCleanupCommand}" /><TreeView ItemsSource="{Binding CleanupGroups}" SelectedItemChanged="CleanupGroupSelected" AutomationProperties.Name="清理分类与规则" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
              <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></TreeView.ItemContainerStyle>
              <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><DockPanel Margin="0,5" ToolTip="分类和规则复选框选择整组目录；可包含未加载的页面。"><CheckBox DockPanel.Dock="Left" IsChecked="{Binding SelectionState,Mode=OneWay}" IsThreeState="True" IsEnabled="{Binding HasSelectable}" Command="{Binding DataContext.ToggleCleanupGroupCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,2,6,0" AutomationProperties.Name="选择整个分类或规则" /><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" /></StackPanel></DockPanel></HierarchicalDataTemplate></TreeView.ItemTemplate>
            </TreeView></DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
          <DataGrid Grid.Column="2" ItemsSource="{Binding Candidates}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" IsReadOnly="False" SelectionMode="Extended" AutomationProperties.Name="清理候选目录">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Eligible}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="选择清理项目" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="目录" Binding="{Binding AbsolutePath}" Width="*" IsReadOnly="True" /><DataGridTextColumn Header="占用估算" Binding="{Binding Size}" SortMemberPath="AllocatedBytes" Width="100" IsReadOnly="True" /><DataGridTextColumn Header="文件数" Binding="{Binding Files}" Width="65" IsReadOnly="True" /><DataGridTextColumn Header="风险与原因" Binding="{Binding Description}" Width="160" IsReadOnly="True" />
              <DataGridTemplateColumn Header="测量" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="继续扫描" Command="{Binding DataContext.ContinueScanCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanContinue,Converter={StaticResource BoolToVisibility}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid></Grid>
          <DockPanel Grid.Row="3" Margin="0,12,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="加载更多目录" Command="{Binding MoreCommand}" /><Button Content="移入回收站…" Command="{Binding CleanCommand}" /><Button Content="永久删除…" Command="{Binding PermanentDeleteCommand}" /></StackPanel><TextBlock Text="{Binding CleanupSelectionSummary}" VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="空间分析">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,8"><DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <RadioButton Content="简洁" GroupName="SpaceView" IsChecked="{Binding StorageSimple}" VerticalAlignment="Center" Margin="4" />
              <RadioButton Content="详细" GroupName="SpaceView" IsChecked="{Binding StorageDetailed}" VerticalAlignment="Center" Margin="4" />
              <Button Content="AI 调查此目录…" Command="{Binding AiFromStorageCommand}" /><Button Content="复制给 AI" Command="{Binding CopyStorageAnalysisCommand}" />
              <Button Content="审阅 AI 规则…" Command="{Binding ReviewRulesCommand}" />
              <Button Content="刷新" Command="{Binding RescanStorageCommand}" /><Button Content="选择目录…" Command="{Binding AnalyzeCommand}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button Content="←" Command="{Binding StorageBackCommand}" ToolTip="后退" AutomationProperties.Name="后退" /><Button Content="→" Command="{Binding StorageForwardCommand}" ToolTip="前进" AutomationProperties.Name="前进" /><Button Content="↑" Command="{Binding StorageUpCommand}" ToolTip="上一级" AutomationProperties.Name="上一级" /></StackPanel>
            <local:ProgressPathTextBlock FullPath="{Binding StorageDisplayPath}" ToolTip="{Binding StorageDisplayPath}" VerticalAlignment="Center" Margin="8,0" />
          </DockPanel>
          <ItemsControl ItemsSource="{Binding StorageBreadcrumbs}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.StorageBreadcrumbCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding Path}" Padding="8,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <WrapPanel Margin="0,8,0,0"><TextBox Width="230" Text="{Binding StorageQuery,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="筛选当前目录已加载的名称" ToolTip="按名称筛选当前目录中已加载的项目" Margin="0,0,8,0" /><Button Content="选择可见项目" Command="{Binding SelectVisibleStorageCommand}" /><Button Content="清空选择" Command="{Binding ClearStorageSelectionCommand}" /><Button Content="加载更多" Command="{Binding MoreStorageCommand}" /><TextBlock Text="{Binding StorageListSummary}" VerticalAlignment="Center" /></WrapPanel>
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding StorageNodes}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" SelectedItem="{Binding SelectedStorageNode}" MouseDoubleClick="OpenStorageNode" Visibility="{Binding StorageSimple, Converter={StaticResource BoolToVisibility}}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding SelectionState,Mode=OneWay}" IsThreeState="True" Click="StorageSelectionClicked" IsEnabled="{Binding CanSelect}" ToolTip="{Binding RemovalReason}" AutomationProperties.Name="选择项目" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="占用估算" Binding="{Binding Size}" SortMemberPath="AllocatedBytes" Width="120" /><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="1" Visibility="{Binding StorageDetailed, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="4" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid TextElement.FontSize="11" Margin="6,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /><ColumnDefinition Width="78" /><ColumnDefinition Width="78" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                  <TextBlock Text="名称" /><TextBlock Grid.Column="1" Text="父级 %" /><TextBlock Grid.Column="2" Text="分配空间" HorizontalAlignment="Right" /><TextBlock Grid.Column="3" Text="逻辑大小" HorizontalAlignment="Right" /><TextBlock Grid.Column="4" Text="文件" HorizontalAlignment="Right" />
                </Grid>
              <TreeView Grid.Row="1" FontSize="11" ItemsSource="{Binding StorageTree}" TreeViewItem.Expanded="StorageTreeExpanded" SelectedItemChanged="StorageTreeSelection" MouseDoubleClick="OpenStorageNode" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="空间目录树">
                <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsSelected" Value="{Binding Focused,Mode=TwoWay}" /><Setter Property="IsExpanded" Value="{Binding Expanded,Mode=TwoWay}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0,1" /></Style></TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <Grid Height="19">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="130" /><ColumnDefinition Width="48" /><ColumnDefinition Width="78" /><ColumnDefinition Width="78" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                    <DockPanel><CheckBox DockPanel.Dock="Left" IsChecked="{Binding SelectionState,Mode=OneWay}" IsThreeState="True" Click="StorageSelectionClicked" IsEnabled="{Binding CanSelect}" ToolTip="{Binding RemovalReason}" Margin="0,0,3,0" AutomationProperties.Name="选择项目" /><TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Margin="0,0,3,0" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></DockPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Share}" TextAlignment="Right" Background="#162779DF" /><TextBlock Grid.Column="2" Text="{Binding Size}" TextAlignment="Right" /><TextBlock Grid.Column="3" Text="{Binding LogicalSize}" TextAlignment="Right" /><TextBlock Grid.Column="4" Text="{Binding Files}" TextAlignment="Right" />
                  </Grid>
                </HierarchicalDataTemplate></TreeView.ItemTemplate>
              </TreeView></Grid>
              <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
              <DataGrid Grid.Column="2" FontSize="11" RowHeight="19" ColumnHeaderHeight="22" GridLinesVisibility="None" HeadersVisibility="Column" AlternatingRowBackground="#08000000" ItemsSource="{Binding StorageExtensions}" SelectedItem="{Binding SelectedStorageExtension}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.Name="文件扩展名">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="扩展名" Width="*" MinWidth="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Width="8" Height="8" Fill="{Binding Color}" Margin="3,0,5,0" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="占比" Binding="{Binding Share}" SortMemberPath="ShareRatio" Width="48" /><DataGridTextColumn Header="分配空间" Binding="{Binding Size}" SortMemberPath="AllocatedBytes" Width="78" /><DataGridTextColumn Header="文件" Binding="{Binding Files}" Width="64" /><DataGridTextColumn Header="逻辑大小" Binding="{Binding LogicalSize}" SortMemberPath="LogicalBytes" Width="78" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />
            <local:StorageSpaceMap x:Name="SpaceMap" Grid.Row="2" Data="{Binding StorageMap}" FocusPath="{Binding StorageFocusPath}" Extension="{Binding StorageExtensionFilter}" AutomationProperties.Name="嵌套空间图" />
          </Grid>
          <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <Expander Header="扫描覆盖详情"><TextBox Text="{Binding StorageCoverageDetails}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" /></Expander>
            <TextBlock Text="{Binding StorageProtection}" TextWrapping="Wrap" Margin="0,6" Opacity="0.8" />
            <WrapPanel HorizontalAlignment="Right"><TextBlock Text="{Binding StorageSelectionSummary}" VerticalAlignment="Center" Margin="8" /><Button Content="在资源管理器中显示" Command="{Binding RevealStorageItemCommand}" /><Button Content="复制路径" Command="{Binding CopyStorageItemPathCommand}" /><Button Content="永久删除所选项目…" Command="{Binding RemoveStorageCommand}" /></WrapPanel>
            <TextBlock Text="颜色表示扩展名，不代表可以清理。筛选仅影响显示，跨目录的选择会保留。" Opacity="0.7" HorizontalAlignment="Right" Margin="0,6,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="规则与排除">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="180" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <WrapPanel><Button Content="AI 生成规则…" Command="{Binding AiFromRulesCommand}" /><Button Content="新建规则…" Command="{Binding CreateRuleCommand}" /><Button Content="导入规则草稿…" Command="{Binding ImportRuleCommand}" /><Button Content="启用所选规则" Command="{Binding EnableRuleCommand}" /><Button Content="停用所选规则" Command="{Binding DisableRuleCommand}" /></WrapPanel>
            <DockPanel Margin="0,8" IsEnabled="{Binding CanEditRuleSettings}"><ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding RuleSource}" MinWidth="150" Margin="12,0,0,0" AutomationProperties.Name="规则来源"><ComboBoxItem Content="所有规则" /><ComboBoxItem Content="内置规则" /><ComboBoxItem Content="个人规则" /></ComboBox><ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" DisplayMemberPath="Path" AutomationProperties.Name="规则和排除的工作区" /></DockPanel>
          </StackPanel>
          <Expander Grid.Row="1" Header="已保存的规则选择" Margin="0,0,0,6">
            <StackPanel IsEnabled="{Binding CanEditRuleSettings}">
              <TextBlock Text="保存当前工作区启用的规则。使用时重新扫描；已停用的规则需要先审阅并启用。" TextWrapping="Wrap" Margin="0,6" />
              <DockPanel><Button DockPanel.Dock="Right" Content="保存启用的规则" Command="{Binding SaveRulePresetCommand}" /><TextBox Text="{Binding PresetName,UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="规则选择名称" /></DockPanel>
              <DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Content="按此选择扫描" Command="{Binding ScanRulePresetCommand}" /><ComboBox ItemsSource="{Binding RulePresets}" SelectedItem="{Binding SelectedRulePreset}" DisplayMemberPath="Label" AutomationProperties.Name="已保存的规则选择" /></DockPanel>
            </StackPanel>
          </Expander>
          <Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Title" AutomationProperties.Name="规则目录" />
            <DockPanel Grid.Column="1" Margin="14,0,0,0">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="内置规则由系统提供；个人规则需逐条预览和启用。项目规则可在选择目录后配置。" TextWrapping="Wrap" Margin="0,0,0,8" />
                <WrapPanel><Button Content="编辑新版本…" Command="{Binding EditRuleCommand}" /><Button Content="导出此版本…" Command="{Binding ExportRuleCommand}" /><Button Content="预览此规则" Command="{Binding PreviewRuleCommand}" /><Button Content="启用并扫描此规则" Command="{Binding EnableAndScanRuleCommand}" /></WrapPanel>
                <TextBlock Text="{Binding RulePreviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8" />
                <TextBlock Text="{Binding RulePreviewDetails}" TextWrapping="Wrap" Margin="0,0,0,8" />
              </StackPanel>
              <DataGrid ItemsSource="{Binding RulePreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.Name="所选规则预览">
                <DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" /><DataGridTextColumn Header="估计占用" Binding="{Binding Size}" Width="100" /><DataGridTextColumn Header="条件与保护" Binding="{Binding Decision}" Width="180" /></DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Grid>
          <Expander Grid.Row="3" x:Name="RuleExclusionsPanel" Header="排除保护" IsExpanded="True">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding CanEditRuleSettings}">
              <TextBlock Text="排除内容也会保护包含它的父级清理目标。修改后需要重新扫描。" TextWrapping="Wrap" Margin="0,6" />
              <ComboBox SelectedIndex="{Binding ExclusionScope}" HorizontalAlignment="Left" MinWidth="180" AutomationProperties.Name="排除范围"><ComboBoxItem Content="所有工作区" /><ComboBoxItem Content="当前工作区" /><ComboBoxItem Content="当前工作区中的项目" /></ComboBox>
              <StackPanel Visibility="{Binding ProjectExclusionScope,Converter={StaticResource BoolToVisibility}}" Margin="0,6"><TextBlock Text="项目相对于工作区的确切目录；模式留空可保护整个项目。" TextWrapping="Wrap" /><TextBox Text="{Binding ExclusionProject,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="项目相对目录" /></StackPanel>
              <DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Content="添加排除" Command="{Binding AddExclusionCommand}" /><TextBox Text="{Binding ExclusionPattern, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" AutomationProperties.Name="相对排除模式" ToolTip="使用 **/target/** 等相对模式；不允许绝对路径或父级遍历。" /></DockPanel>
              <ListBox ItemsSource="{Binding Exclusions}" SelectedItem="{Binding SelectedExclusion}" MaxHeight="90" AutomationProperties.Name="当前范围的排除" />
              <TextBlock Text="{Binding InheritedExclusions}" TextWrapping="Wrap" Opacity="0.7" Margin="0,6" />
              <Button Content="移除所选排除" Command="{Binding RemoveExclusionCommand}" HorizontalAlignment="Right" />
            </StackPanel></ScrollViewer>
          </Expander>
        </Grid>
      </TabItem>
      <TabItem Header="历史与恢复">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" MinHeight="75" /><RowDefinition Height="5" /><RowDefinition Height="3*" MinHeight="150" /></Grid.RowDefinitions>
          <WrapPanel><Button Content="刷新" Command="{Binding HistoryCommand}" /><Button Content="加载更多" Command="{Binding MoreHistoryCommand}" /><Button Content="回收扫描记录" Command="{Binding CollectRecordsCommand}" /><Button Content="清理已结束记录…" Command="{Binding ClearHistoryCommand}" /><Button Content="删除所选记录…" Command="{Binding RemoveHistoryCommand}" /></WrapPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" SelectionMode="Single" IsEnabled="{Binding HistorySelectionEnabled}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" Margin="0,14,0,0" AutomationProperties.Name="操作历史">
            <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="190" /><DataGridTextColumn Header="目录" Binding="{Binding Label}" Width="*" /><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="140" /></DataGrid.Columns>
          </DataGrid>
          <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" />
          <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <WrapPanel><TextBlock Text="所选记录的逐项结果" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="全选可操作项" Command="{Binding SelectHistoryItemsCommand}" /><Button Content="清空选择" Command="{Binding ClearHistoryItemsCommand}" /><Button Content="核验位置…" Command="{Binding InspectHistoryCommand}" /></WrapPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryItems}" IsEnabled="{Binding HistorySelectionEnabled}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" Margin="0,8,0,0" AutomationProperties.Name="所选历史记录的逐项结果">
              <DataGrid.Columns>
                <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Eligible}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="选择历史项目" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="原始路径" Binding="{Binding Path}" Width="2*" MinWidth="160" /><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="120" /><DataGridTextColumn Header="占用估算" Binding="{Binding Size}" SortMemberPath="AllocatedBytes" Width="100" /><DataGridTextColumn Header="可用操作" Binding="{Binding Actions}" Width="130" /><DataGridTextColumn Header="实际结果路径" Binding="{Binding ResultingPath}" Width="*" MinWidth="120" /><DataGridTextColumn Header="原因" Binding="{Binding Error}" Width="160" />
              </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="2" Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="恢复所选项目…" Command="{Binding RestoreCommand}" /><Button Content="永久删除所选项目…" Command="{Binding PurgeCommand}" /></StackPanel><TextBlock Text="{Binding HistorySelectionSummary}" VerticalAlignment="Center" TextWrapping="Wrap" /></DockPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="大文件">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="选择目录并扫描…" Command="{Binding ChooseLargeFilesFolderCommand}" /><Button Content="开始扫描" Command="{Binding ScanLargeFilesCommand}" /><Button Content="使用空间分析结果" Command="{Binding UseStorageForLargeFilesCommand}" /></StackPanel><TextBox Text="{Binding LargeFilesFolder,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="大文件扫描目录" MinWidth="180" /></DockPanel>
          <WrapPanel Grid.Row="1" Margin="0,12"><TextBlock Text="最小大小（MiB）" VerticalAlignment="Center" /><TextBox Text="{Binding LargeFilesMinimumMiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="85" Margin="8,0,16,0" AutomationProperties.Name="大文件最小大小" /><ComboBox ItemsSource="{Binding LargeFileTypes}" SelectedItem="{Binding SelectedLargeFileType}" DisplayMemberPath="Name" Width="120" AutomationProperties.Name="大文件类型" /><Button Content="应用筛选" Command="{Binding FilterLargeFilesCommand}" /><Button Content="全选已加载 / 取消" Command="{Binding SelectLoadedLargeFilesCommand}" /><Button Content="选择全部匹配文件" Command="{Binding SelectAllLargeFilesCommand}" /><Button Content="加载更多" Command="{Binding MoreLargeFilesCommand}" /></WrapPanel>
          <TextBlock Grid.Row="2" Text="{Binding LargeFilesSummary}" Margin="0,0,0,10" TextWrapping="Wrap" />
          <DataGrid Grid.Row="3" ItemsSource="{Binding LargeFiles}" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.Name="大文件结果">
            <DataGrid.Columns><DataGridTemplateColumn Header="AI" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="调查父目录" Command="{Binding DataContext.AiFromLargeFileCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Eligible}" HorizontalAlignment="Center" AutomationProperties.Name="选择大文件" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="文件" Binding="{Binding Name}" Width="180" IsReadOnly="True" /><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" IsReadOnly="True" /><DataGridTextColumn Header="占用空间" Binding="{Binding Size}" SortMemberPath="AllocatedBytes" Width="100" IsReadOnly="True" /><DataGridTextColumn Header="逻辑大小" Binding="{Binding LogicalSize}" SortMemberPath="LogicalBytes" Width="100" IsReadOnly="True" /><DataGridTextColumn Header="保护条件" Binding="{Binding Protection}" Width="160" IsReadOnly="True" />
              <DataGridTemplateColumn Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="所在目录" Command="{Binding DataContext.RevealLargeFileCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="4" Margin="0,14,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="移入回收站…" Command="{Binding TrashLargeFilesCommand}" /><Button Content="永久删除…" Command="{Binding PurgeLargeFilesCommand}" /></StackPanel><TextBlock Text="{Binding LargeFilesSelection}" VerticalAlignment="Center" /></DockPanel>
        </Grid>
      </TabItem>
    <TabItem Header="AI 调查"><local:AIWorkspaceView /></TabItem>
    <TabItem Header="启动项"><local:StartupView /></TabItem>
    <TabItem Header="应用"><local:ApplicationsView /></TabItem>
    <TabItem Header="扫描范围"><local:ScanLocationsView /></TabItem>
    </TabControl>
    <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
  </Grid>
  <Border Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="36" Margin="0,54,0,0" AutomationProperties.Name="操作进度">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
      <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="68" Foreground="#2779DF" HorizontalAlignment="Center" Margin="0,0,0,28" />
      <TextBlock Text="{Binding Status}" TextAlignment="Center" FontSize="18" Margin="0,0,0,20" />
      <TextBlock Text="{Binding ProgressPercentage}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12" />
      <ProgressBar Height="8" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}" />
      <local:ProgressPathTextBlock FullPath="{Binding ProgressFullPath}" ToolTip="{Binding ProgressFullPath}" TextAlignment="Center" Opacity="0.65" Margin="0,12,0,24" />
      <Button Content="停止" Command="{Binding CancelCommand}" Width="180" Padding="20,10" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
  <Border Visibility="{Binding CompletionVisible, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="28" Margin="0,54,0,0" AutomationProperties.Name="清理完成结果">
    <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" CornerRadius="16" Padding="34" MaxWidth="720" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Completion.Icon}" FontSize="56" HorizontalAlignment="Center" Foreground="#2E7D32" />
        <TextBlock Grid.Row="1" Text="{Binding Completion.Title}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock Grid.Row="2" Text="{Binding Completion.SuccessText}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,0" />
        <TextBlock Grid.Row="3" Text="{Binding Completion.Message}" Opacity="0.7" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,18" />
        <StackPanel Grid.Row="4">
          <UniformGrid Columns="4" Margin="0,0,0,12" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.Processed}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="已处理" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.Skipped}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="已跳过" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.Failed}" FontSize="20" FontWeight="SemiBold" Foreground="#C62828" HorizontalAlignment="Center" /><TextBlock Text="失败项" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
            <StackPanel Margin="5"><TextBlock Text="{Binding Completion.NeedsVerification}" FontSize="20" FontWeight="SemiBold" Foreground="#EF6C00" HorizontalAlignment="Center" /><TextBlock Text="需核实" Opacity="0.7" HorizontalAlignment="Center" /></StackPanel>
          </UniformGrid>
          <Expander Header="查看详情" IsExpanded="False" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
              <ItemsControl ItemsSource="{Binding Completion.Items}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="#22000000" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
                  <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding State}" Opacity="0.75" />
                  <TextBlock Text="{Binding Error}" Foreground="#C62828" TextWrapping="Wrap" />
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
          </Expander>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
          <Button Content="重新扫描" Command="{Binding RetryCleanupCommand}" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
          <Button Content="查看操作记录" Command="{Binding ViewHistoryFromCompletionCommand}" Visibility="{Binding CompletionHasIssues, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
          <Button Content="返回" Command="{Binding DismissCompletionCommand}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Border>
  </Grid>
</Window>
