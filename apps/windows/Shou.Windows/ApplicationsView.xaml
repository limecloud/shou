<UserControl x:Class="Shou.Windows.ApplicationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <WrapPanel><Button Content="扫描已安装的应用" Command="{Binding ScanApplicationsCommand}" /><Button Content="打开已安装的应用" Command="{Binding ManageApplicationsCommand}" /><Button Content="复制所选应用名称" Command="{Binding CopyApplicationNameCommand}" /><CheckBox Content="包括系统组件和包依赖" IsChecked="{Binding IncludeSystemApplications}" IsEnabled="{Binding CanEditRuleSettings}" VerticalAlignment="Center" /></WrapPanel>
      <TextBlock Text="{Binding ApplicationInventorySummary}" Margin="0,10" />
    </StackPanel>
    <DockPanel Grid.Row="1" IsEnabled="{Binding CanEditRuleSettings}" Margin="0,0,0,10"><ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding ApplicationScope}" MinWidth="150" Margin="10,0,0,0" AutomationProperties.Name="应用来源筛选"><ComboBoxItem Content="所有应用" /><ComboBoxItem Content="当前用户桌面应用" /><ComboBoxItem Content="全机桌面应用" /><ComboBoxItem Content="MSIX 包" /></ComboBox><TextBox Text="{Binding ApplicationQuery,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="搜索应用名称、发布者和安装位置" /></DockPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding RegisteredApplications}" SelectedItem="{Binding SelectedRegisteredApplication}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" EnableRowVirtualization="True" AutomationProperties.Name="已注册应用">
      <DataGrid.Columns><DataGridTextColumn Header="应用" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="100" /><DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="*" /><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80" /><DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="90" /><DataGridTextColumn Header="注册大小估计" Binding="{Binding Size}" SortMemberPath="EstimatedBytes" Width="120" /></DataGrid.Columns>
    </DataGrid>
    <Expander Grid.Row="3" Header="所选应用详情" Margin="0,8"><ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding SelectedRegisteredApplication.Location}" /><TextBox Text="{Binding SelectedRegisteredApplication.Details,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" AutomationProperties.Name="应用注册详情" /></StackPanel></ScrollViewer></Expander>
    <Expander Grid.Row="4" Header="扫描覆盖与限制"><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding ApplicationCoverageSummary}" Margin="0,8" /><DataGrid ItemsSource="{Binding ApplicationCoverage}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AutomationProperties.Name="应用盘点来源覆盖"><DataGrid.Columns><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="*" /><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="120" /><DataGridTextColumn Header="已检查注册" Binding="{Binding Entries}" Width="100" /><DataGridTextColumn Header="应用" Binding="{Binding Applications}" Width="80" /></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></Expander>
  </Grid>
</UserControl>
