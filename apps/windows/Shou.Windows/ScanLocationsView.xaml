<UserControl x:Class="Shou.Windows.ScanLocationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="扫描范围" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="常用项目位置和内置缓存会自动发现。其他文件夹包含一次后，会加入后续一键扫描。" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,14,0,0"><Button Content="刷新位置" Command="{Binding RefreshScanLocationsCommand}" /><Button Content="包含文件夹…" Command="{Binding ChooseFolderCommand}" /><Button Content="复制所选路径" Command="{Binding CopyScanLocationPathCommand}" /><Button Content="停止包含所选文件夹…" Command="{Binding StopIncludingLocationCommand}" /></WrapPanel>
    <Grid Grid.Row="2" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
      <TextBox Text="{Binding ScanLocationQuery,UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.Name="搜索扫描位置" Margin="0,0,12,0" />
      <ComboBox Grid.Column="1" SelectedIndex="{Binding ScanLocationScope}" AutomationProperties.Name="扫描位置来源"><ComboBoxItem Content="全部来源" /><ComboBoxItem Content="自动发现的项目" /><ComboBoxItem Content="额外包含的文件夹" /><ComboBoxItem Content="内置缓存位置" /></ComboBox>
    </Grid>
    <DataGrid Grid.Row="3" ItemsSource="{Binding ScanLocations}" SelectedItem="{Binding SelectedScanLocation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" SelectionMode="Single" AutomationProperties.Name="扫描位置列表">
      <DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="170" /><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" MinWidth="180" /><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="160" /><DataGridTextColumn Header="可用状态" Binding="{Binding State}" Width="120" /></DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="{Binding ScanLocationsSummary}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedScanLocation.Details}" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75" /></StackPanel>
  </Grid>
</UserControl>
