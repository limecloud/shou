<UserControl x:Class="Shou.Windows.DiskCapacityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,6" MaxWidth="600" HorizontalAlignment="Left">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" MinWidth="240">
      <TextBlock x:Name="CapacityLabel" Text="正在读取磁盘容量…" TextWrapping="Wrap" FontSize="12" />
      <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="100" Height="4" Margin="0,5,0,0" Visibility="Collapsed" AutomationProperties.Name="磁盘已用空间比例" />
    </StackPanel>
    <Button Grid.Column="1" Content="↻" Click="RefreshClicked" Padding="7,3" Margin="10,0,0,0" ToolTip="刷新此目录所在磁盘的容量" AutomationProperties.Name="刷新磁盘容量" />
  </Grid>
</UserControl>
