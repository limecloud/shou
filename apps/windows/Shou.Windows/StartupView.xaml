<UserControl x:Class="Shou.Windows.StartupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="启动项" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="检查随登录、开机或服务启动的注册项。仅直接启停已核验的当前用户计划任务；其他来源可在 Windows 中管理。" Margin="0,8,0,12" TextWrapping="Wrap" /></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="扫描启动项" Command="{Binding ScanStartupCommand}" /><CheckBox Content="包含全机注册表、公共目录、系统任务和服务" IsChecked="{Binding StartupIncludeSystem}" IsEnabled="{Binding StartupCanEdit}" VerticalAlignment="Center" Margin="12,0" /><Button Content="Windows 启动设置" Command="{Binding StartupSettingsCommand}" /><Button Content="任务计划程序" Command="{Binding StartupTaskSchedulerCommand}" /><Button Content="服务管理" Command="{Binding StartupServicesCommand}" /></WrapPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,12"><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding StartupFilters}" SelectedItem="{Binding SelectedStartupFilter}" DisplayMemberPath="Name" Width="140" Margin="12,0,0,0" AutomationProperties.Name="启动项状态筛选" /><TextBox Text="{Binding StartupQuery,UpdateSourceTrigger=PropertyChanged}" MaxLength="2048" ToolTip="搜索名称、来源或路径" AutomationProperties.Name="搜索启动项" /></DockPanel>
    <DataGrid Grid.Row="3" ItemsSource="{Binding StartupItems}" SelectedItem="{Binding SelectedStartupItem}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" EnableRowVirtualization="True" CanUserAddRows="False" AutomationProperties.Name="启动项清单"><DataGrid.Columns>
      <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180" /><DataGridTextColumn Header="配置" Binding="{Binding State}" Width="70" /><DataGridTextColumn Header="运行状态" Binding="{Binding Activity}" Width="90" /><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="160" /><DataGridTextColumn Header="目标" Binding="{Binding TargetDescription}" Width="125" /><DataGridTextColumn Header="程序路径" Binding="{Binding Program}" Width="*" MinWidth="140" /><DataGridTextColumn Header="管理方式" Binding="{Binding Management}" Width="190" />
    </DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><TextBlock Text="{Binding Path}" TextWrapping="Wrap" Margin="16,8" /></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid>
    <StackPanel Grid.Row="4" Margin="0,12,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="启用所选任务…" Command="{Binding EnableStartupCommand}" /><Button Content="停用所选任务…" Command="{Binding DisableStartupCommand}" /></StackPanel><TextBlock Text="{Binding StartupSummary}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel><Expander Header="来源覆盖与未核实状态" Margin="0,12,0,0"><TextBox Text="{Binding StartupCoverage,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="0,8" /></Expander></StackPanel>
  </Grid>
</UserControl>
