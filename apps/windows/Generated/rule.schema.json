{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shou rule format 1.0 (design draft)",
  "description": "Declarative cleanup rules. Structural validation does not grant filesystem access or execution approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "description", "platforms", "scope", "match", "conditions", "exclude", "risk", "action"],
  "properties": {
    "$schema": {"type": "string", "maxLength": 512},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 128},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "platforms": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["macos", "windows"]}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_ref", "max_depth", "follow_symlinks", "cross_filesystems"],
      "properties": {
        "root_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 80},
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 32},
        "follow_symlinks": {"const": false},
        "cross_filesystems": {"const": false}
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relative_patterns"],
      "properties": {
        "kind": {"const": "directory"},
        "relative_patterns": {"$ref": "#/$defs/nonEmptyPatterns"},
        "project_markers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["location", "all_of"],
          "properties": {
            "location": {"const": "parent"},
            "all_of": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255}}
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_allocated_bytes"],
      "properties": {
        "min_allocated_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "newest_descendant_modified_days_at_least": {"type": "integer", "minimum": 0, "maximum": 3650}
      }
    },
    "exclude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_patterns"],
      "properties": {
        "relative_patterns": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePattern"}}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_level", "rebuild_note", "limitations"],
      "properties": {
        "declared_level": {"enum": ["review", "high"]},
        "rebuild_note": {"type": "string", "minLength": 1, "maxLength": 2000},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "trash"}}
    }
  },
  "$defs": {
    "relativePattern": {"type": "string", "minLength": 1, "maxLength": 512},
    "nonEmptyPatterns": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePattern"}}
  }
}
