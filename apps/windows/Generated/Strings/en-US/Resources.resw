  <data name="s73a27ebf83dc2f98f4c603f5" xml:space="preserve">
    <value>Only measured space is included. Complete folders remain available even when another location cannot be read.</value>
  </data>
  <data name="s618f76408ddeb2eff68c2437" xml:space="preserve">
    <value>Only named cache subdirectories in the default Windows user location are included. Close the owning application and stop affected builds first. Profiles, accounts, credentials, sessions, settings, extensions, environments and project sources are retained. Custom locations require separate review.</value>
  </data>
  <data name="sb42004078e671d4b95a6afdd" xml:space="preserve">
    <value>Only named user cache directories are targeted. Documents, preferences and system-owned data are retained.</value>
