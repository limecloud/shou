<Window
    x:Class="Shou.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Navigation" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneDisplayMode="Left" SelectionChanged="Navigate">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="CleanupNavigation" Tag="cleanup" />
            <NavigationViewItem x:Name="StorageNavigation" Tag="storage" />
            <NavigationViewItem x:Name="ApplicationsNavigation" Tag="applications" />
            <NavigationViewItem x:Name="StartupNavigation" Tag="startup" />
            <NavigationViewItem x:Name="PrivacyNavigation" Tag="privacy" />
            <NavigationViewItem x:Name="ConfigurationNavigation" Tag="configuration" />
            <NavigationViewItem x:Name="HistoryNavigation" Tag="history" />
        </NavigationView.MenuItems>
        <Grid>
            <Grid x:Name="StorageContent" Margin="{StaticResource ShouPagePadding}" RowSpacing="{StaticResource ShouSectionSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="{StaticResource ShouSectionSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource ShouItemSpacing}">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="PageDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TotalSize" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="{StaticResource ShouItemSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ScopeBox" IsReadOnly="True" />
                    <Button Grid.Column="1" x:Name="ChooseButton" Click="ChooseFolder" />
                    <Button Grid.Column="2" x:Name="ScanButton" Click="ScanFolder" Style="{StaticResource AccentButtonStyle}" />
                    <Button Grid.Column="3" x:Name="CancelButton" Click="CancelScan" />
                </Grid>
                <StackPanel Grid.Row="2" Spacing="{StaticResource ShouItemSpacing}">
                    <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <InfoBar x:Name="CoverageNotice" IsClosable="False" IsOpen="False" Severity="Warning" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Click="GoUp" />
                    <TextBlock Grid.Column="1" x:Name="CurrentPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ListView Grid.Row="4" x:Name="ResultsList" IsItemClickEnabled="True" ItemClick="OpenDirectory" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,10" ColumnSpacing="{StaticResource ShouSectionSpacing}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path.Value}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplaySize}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}" HorizontalAlignment="Right">
                    <Button x:Name="PreviousButton" Click="PreviousPage" />
                    <Button x:Name="NextButton" Click="NextPage" />
                </StackPanel>
            </Grid>
            <ContentControl x:Name="CleanupHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="ApplicationsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="StartupHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="PrivacyHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="HistoryHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
            <ContentControl x:Name="ConfigurationHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" />
        </Grid>
    </NavigationView>
</Window>
