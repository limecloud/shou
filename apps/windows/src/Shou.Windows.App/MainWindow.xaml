<Window x:Class="Shou.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WindowRoot" Background="{ThemeResource ShouCanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid x:Name="Sidebar" Background="{ThemeResource ShouSidebarBrush}" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions><RowDefinition x:Name="SidebarHeaderRow" Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid x:Name="SidebarDragRegion" Padding="8,0">
                <Button x:Name="PaneButton" Style="{StaticResource ShouToolbarButton}" Click="ToggleSidebar" Visibility="Collapsed" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10,8,10,0">
                <TextBlock x:Name="StorageHeading" Style="{StaticResource ShouCaption}" Margin="10,4,0,6" />
                <Button x:Name="CleanupNavigation" Tag="cleanup" Style="{StaticResource ShouNavigationButton}" Click="Navigate" />
                <Button x:Name="LargeFilesNavigation" Tag="large" Style="{StaticResource ShouNavigationButton}" Click="Navigate" />
                <Button x:Name="StorageNavigation" Tag="storage" Style="{StaticResource ShouNavigationButton}" Click="Navigate" />
                <TextBlock x:Name="ToolsHeading" Style="{StaticResource ShouCaption}" Margin="10,18,0,6" />
                <Button x:Name="ConfigurationNavigation" Tag="configuration" Style="{StaticResource ShouNavigationButton}" Click="Navigate" />
                <Button x:Name="StartupNavigation" Tag="startup" Style="{StaticResource ShouNavigationButton}" Click="Navigate" />
                <Button x:Name="ApplicationsNavigation" Tag="applications" Style="{StaticResource ShouNavigationButton}" Click="Navigate" />
                <Button x:Name="PrivacyNavigation" Tag="privacy" Style="{StaticResource ShouNavigationButton}" Click="Navigate" />
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="2" Margin="10,8,10,10" Spacing="2">
                <Button x:Name="CollapseSidebarButton" Style="{StaticResource ShouToolbarButton}" Click="ToggleSidebar" HorizontalAlignment="Right" Margin="0,0,4,4"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                <Border Height="1" Background="{ThemeResource ShouDividerBrush}" Margin="8,0,8,8" />
                <Button x:Name="HistoryNavigation" Tag="history" Style="{StaticResource ShouFooterNavigationButton}" Click="Navigate" />
                <Button x:Name="SettingsNavigation" Tag="settings" Style="{StaticResource ShouFooterNavigationButton}" Click="Navigate" />
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition x:Name="TitlebarRow" Height="Auto" /><RowDefinition Height="*" /><RowDefinition x:Name="FooterRow" Height="Auto" /></Grid.RowDefinitions>
            <Grid Padding="16,0,140,0" Background="{ThemeResource ShouTitlebarBrush}" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="ShowSidebarButton" Style="{StaticResource ShouToolbarButton}" Click="ToggleSidebar" Visibility="Collapsed"><FontIcon Glyph="&#xE700;" FontSize="14" /></Button><Grid x:Name="TitleDragRegion" Grid.Column="1"><TextBlock x:Name="PageTitle" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{StaticResource ShouBodyFontSize}" /></Grid></Grid>
                <ContentControl Grid.Column="1" x:Name="ToolbarHost" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" />
                <Button Grid.Column="2" x:Name="LanguageButton" Style="{StaticResource ShouToolbarButton}" Padding="4,0"><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="SystemLanguageItem" Tag="system" Click="ChangeLanguage" /><MenuFlyoutItem Text="简体中文" Tag="zh-CN" Click="ChangeLanguage" /><MenuFlyoutItem Text="English" Tag="en-US" Click="ChangeLanguage" /></MenuFlyout></Button.Flyout></Button>
                <Grid Grid.Column="3" x:Name="DiskCapacity" Width="{StaticResource ShouDiskMeterWidth}" ColumnSpacing="8" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ContentControl x:Name="DiskIcon" Width="14" Height="14" VerticalAlignment="Center" IsTabStop="False" /><StackPanel Grid.Column="1" Spacing="3"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="DiskName" FontSize="{StaticResource ShouCaptionFontSize}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" x:Name="DiskFree" Style="{StaticResource ShouCaption}" /></Grid><ProgressBar x:Name="DiskMeter" Height="6" MinHeight="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Background="{ThemeResource ShouDividerBrush}" /></StackPanel></Grid>
            </Grid>
            <ContentControl Grid.Row="1" x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <Grid Grid.Row="2" Padding="16,0" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="WindowStatus" AutomationProperties.AutomationId="window.status" Style="{StaticResource ShouCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" /><TextBlock Grid.Column="1" x:Name="VersionText" Style="{StaticResource ShouMonoCaption}" VerticalAlignment="Center" /></Grid>
        </Grid>
    </Grid>
</Window>
