<Window x:Class="Shou.Windows.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="WindowRoot" Background="{ThemeResource ShouWorkspaceBrush}">
        <Grid.RowDefinitions><RowDefinition x:Name="TitlebarRow" Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Padding="28,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid x:Name="TitleDragRegion"><TextBlock x:Name="PageTitle" VerticalAlignment="Center" FontWeight="SemiBold" /></Grid>
            <ContentControl Grid.Column="1" x:Name="ToolbarHost" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" />
            <Button Grid.Column="2" x:Name="LanguageButton" Style="{StaticResource ShouToolbarButton}"><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="SystemLanguageItem" Tag="system" Click="ChangeLanguage" /><MenuFlyoutItem Text="简体中文" Tag="zh-CN" Click="ChangeLanguage" /><MenuFlyoutItem Text="English" Tag="en-US" Click="ChangeLanguage" /></MenuFlyout></Button.Flyout></Button>
            <Grid Grid.Column="3" x:Name="DiskCapacity" Width="{StaticResource ShouDiskMeterWidth}" ColumnSpacing="8" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ContentControl x:Name="DiskIcon" Width="14" Height="14" VerticalAlignment="Center" IsTabStop="False" /><StackPanel Grid.Column="1" Spacing="3"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="DiskName" FontSize="{StaticResource ShouCaptionFontSize}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" x:Name="DiskFree" Style="{StaticResource ShouCaption}" /></Grid><ProgressBar x:Name="DiskMeter" Height="6" MinHeight="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Background="{ThemeResource ShouDividerBrush}" /></StackPanel></Grid>
        </Grid>
        <Grid Grid.Row="1" MinHeight="{StaticResource ShouWorkspaceCompactHeaderHeight}" Padding="28,4" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Shou" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="CleanupNavigation" Tag="cleanup" Style="{StaticResource ShouTopNavigationButton}" Click="Navigate" />
                <Button x:Name="ApplicationsNavigation" Tag="applications" Style="{StaticResource ShouTopNavigationButton}" Click="Navigate" />
                <Button x:Name="StorageNavigation" Tag="storage" Style="{StaticResource ShouTopNavigationButton}" Click="Navigate" />
                <Button x:Name="MonitorNavigation" Tag="monitor" Style="{StaticResource ShouTopNavigationButton}" Click="Navigate" />
                <Button x:Name="ConfigurationNavigation" Tag="configuration" Style="{StaticResource ShouTopNavigationButton}" Click="Navigate" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                <Button x:Name="HistoryNavigation" Tag="history" Style="{StaticResource ShouToolbarButton}" Click="Navigate" />
                <Button x:Name="SettingsNavigation" Tag="settings" Style="{StaticResource ShouToolbarButton}" Click="Navigate" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Padding="28,2,28,6" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="CleanupTasks" Orientation="Horizontal" Spacing="14"><Button x:Name="CleanupDetailNavigation" Tag="cleanup" Style="{StaticResource ShouToolbarButton}" Click="Navigate" /><Button x:Name="PrivacyNavigation" Tag="privacy" Style="{StaticResource ShouToolbarButton}" Click="Navigate" /></StackPanel>
            <StackPanel x:Name="ApplicationTasks" Orientation="Horizontal" Spacing="14" Visibility="Collapsed"><Button x:Name="ApplicationsDetailNavigation" Tag="applications" Style="{StaticResource ShouToolbarButton}" Click="Navigate" /><Button x:Name="ProjectsNavigation" Tag="projects" Style="{StaticResource ShouToolbarButton}" Click="Navigate" /><Button x:Name="StartupNavigation" Tag="startup" Style="{StaticResource ShouToolbarButton}" Click="Navigate" /></StackPanel>
            <StackPanel x:Name="StorageTasks" Orientation="Horizontal" Spacing="14" Visibility="Collapsed"><Button x:Name="StorageDetailNavigation" Tag="storage" Style="{StaticResource ShouToolbarButton}" Click="Navigate" /><Button x:Name="LargeFilesNavigation" Tag="large" Style="{StaticResource ShouToolbarButton}" Click="Navigate" /></StackPanel>
        </Grid>
        <ContentControl Grid.Row="3" x:Name="PageHeading" HorizontalContentAlignment="Stretch" />
        <ContentControl Grid.Row="4" x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <TextBlock Grid.Row="5" x:Name="WindowStatus" AutomationProperties.AutomationId="window.status" AutomationProperties.LiveSetting="Polite" Height="1" Opacity="0" TextWrapping="Wrap" />
    </Grid>
</Window>
