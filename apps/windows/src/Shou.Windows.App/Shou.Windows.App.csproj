<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <SelfContained Condition="'$(RuntimeIdentifier)' == ''">false</SelfContained>
    <Platforms>x64;ARM64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../Generated/Shou.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <MicrosoftManagementDeployment-FactoryLinkage Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != 'x64' and '$(Platform)' != 'ARM64'">none</MicrosoftManagementDeployment-FactoryLinkage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.10.340" />
    <ProjectReference Include="../Shou.Windows.Core/Shou.Windows.Core.csproj" />
    <ProjectReference Include="../Shou.Windows.Platform/Shou.Windows.Platform.csproj" />
    <ProjectReference Include="../Shou.Windows.Presentation/Shou.Windows.Presentation.csproj" />
    <Page Include="../../Generated/Design.xaml" Link="Generated/Design.xaml" />
    <Content Include="../../Generated/Shou.ico" Link="Shou.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Generated/Illustrations/*.png" Link="Assets/Illustrations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../Generated/SoftwareIcons/*" Link="Assets/SoftwareIcons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PRIResource Include="../../Generated/Strings/**/*.resw" Link="Strings/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- MRT Core generates the unpackaged PRI during Build, but does not add it to .NET Publish. -->
  <Target Name="PublishWinUIResources" AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="_GenerateProjectPriFile" Condition="'$(CopyBuildOutputToPublishDirectory)' == 'true'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The generated WinUI PRI resource index is missing: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
