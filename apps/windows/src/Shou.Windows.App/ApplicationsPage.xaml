<UserControl
    x:Class="Shou.Windows.App.ApplicationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource ShouPagePadding}" RowSpacing="{StaticResource ShouSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource ShouItemSpacing}">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Description" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="{StaticResource ShouItemSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" MaxLength="256" TextChanged="ChangeSearch" />
            <ComboBox Grid.Column="1" x:Name="SortBox" SelectionChanged="ChangeSort" MinWidth="160">
                <ComboBoxItem x:Name="NameSort" />
                <ComboBoxItem x:Name="SizeSort" />
            </ComboBox>
            <Button Grid.Column="2" x:Name="RefreshButton" Click="Refresh" />
            <Button Grid.Column="3" x:Name="CancelButton" Click="Cancel" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="{StaticResource ShouItemSpacing}">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="CoverageNotice" IsClosable="False" IsOpen="False" Severity="Warning" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="CoverageText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="{StaticResource ShouPageSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="ApplicationsList" SelectionMode="Single" SelectionChanged="SelectApplication">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,10" ColumnSpacing="{StaticResource ShouSectionSpacing}" AutomationProperties.Name="{Binding Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RegisteredSize}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="Details" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <Button x:Name="InspectButton" Click="InspectUninstall" />
                        <CheckBox x:Name="InstallerDataConsent" Click="ChangeInstallerDataConsent">
                            <TextBlock x:Name="InstallerDataDescription" TextWrapping="Wrap" />
                        </CheckBox>
                        <Button x:Name="PreparePlanButton" Click="PrepareUninstallPlan" />
                        <Button x:Name="ExecuteButton" Click="ExecuteUninstall" />
                        <Button x:Name="ReadExecutionButton" Click="ReadUninstallExecution" />
                        <TextBlock x:Name="UninstallStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource ShouItemSpacing}">
            <Button x:Name="PreviousButton" Click="Previous" />
            <Button x:Name="NextButton" Click="Next" />
        </StackPanel>
    </Grid>
</UserControl>
