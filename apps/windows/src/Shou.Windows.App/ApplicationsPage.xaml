<UserControl x:Class="Shou.Windows.App.ApplicationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentControl x:Name="LandingHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    <Grid x:Name="PageLayout">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="PageToolbar" Orientation="Horizontal" Spacing="8">
            <Button x:Name="InfoButton" Style="{StaticResource ShouToolbarButton}"><FontIcon Glyph="&#xE946;" /><Button.Flyout><Flyout><StackPanel Width="380" Spacing="12"><TextBlock x:Name="Description" TextWrapping="Wrap" /><InfoBar x:Name="CoverageNotice" IsClosable="False" Severity="Warning" /><TextBlock x:Name="CoverageText" TextWrapping="Wrap" Style="{StaticResource ShouCaption}" /></StackPanel></Flyout></Button.Flyout></Button>
            <Button x:Name="ShortcutsButton" Click="ReviewShortcuts" Style="{StaticResource ShouToolbarButton}" /><Button x:Name="RefreshButton" Click="Refresh" Style="{StaticResource ShouToolbarButton}" /><Button x:Name="CancelButton" Click="Cancel" Style="{StaticResource ShouToolbarButton}" />
        </StackPanel>
        <Border Grid.Row="0" Margin="20,0,20,10" Style="{StaticResource ShouCatalogCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="0">
            <Grid Padding="14" ColumnSpacing="10" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,0.5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="ApplicationSummary" FontWeight="Medium" FontSize="{StaticResource ShouCatalogTextFontSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="EstimatedLabel" Style="{StaticResource ShouCaption}" VerticalAlignment="Center" /><TextBlock x:Name="EstimatedBytes" FontWeight="SemiBold" FontSize="{StaticResource ShouSummaryFigureSize}" Foreground="{ThemeResource ShouAccentBrush}" VerticalAlignment="Center" /></StackPanel><HyperlinkButton Grid.Column="1" x:Name="CoverageButton" Style="{StaticResource ShouLinkButton}" FontSize="{StaticResource ShouCaptionFontSize}" MinHeight="0" MinWidth="0" VerticalAlignment="Center" Click="ShowCoverage" Visibility="Collapsed" AutomationProperties.AutomationId="applications.coverage"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7BA;" FontSize="10" /><TextBlock x:Name="CoverageLabel" /></StackPanel></HyperlinkButton></Grid>
            <Grid Padding="10,6" ColumnSpacing="12" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,0.5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4"><ToggleButton x:Name="FilterAll" Tag="all" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /><ToggleButton x:Name="FilterSystem" Tag="system" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /><ToggleButton x:Name="FilterSized" Tag="sized" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /><ToggleButton x:Name="FilterCurrentUser" Tag="user" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /></StackPanel>
                <TextBox Grid.Column="1" x:Name="SearchBox" AutomationProperties.AutomationId="applications.search" MaxLength="256" TextChanged="ChangeSearch" /><ComboBox Grid.Column="2" x:Name="SortBox" SelectionChanged="ChangeSort" MinWidth="140"><ComboBoxItem x:Name="NameSort" /><ComboBoxItem x:Name="SizeSort" /></ComboBox>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1"><ProgressBar x:Name="Progress" Visibility="Collapsed" /><TextBlock x:Name="Status" AutomationProperties.AutomationId="applications.status" Style="{StaticResource ShouCaption}" Margin="20,0,20,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Padding="8,8" ColumnSpacing="12" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,0.5"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="88" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions><TextBlock Grid.Column="2" x:Name="NameHeading" Style="{StaticResource ShouCaption}" /><TextBlock Grid.Column="3" x:Name="StateHeading" Style="{StaticResource ShouCaption}" /><TextBlock Grid.Column="4" x:Name="SizeHeading" Style="{StaticResource ShouCaption}" HorizontalAlignment="Right" /></Grid>
            <ListView Grid.Row="1" x:Name="ApplicationsList" AutomationProperties.AutomationId="applications.results" SelectionMode="Single" SelectionChanged="SelectApplication" ItemContainerStyle="{StaticResource ShouTableItem}"><ListView.ItemTemplate><DataTemplate><Expander Style="{StaticResource ShouRowExpander}" Tag="{Binding}" Header="{Binding}" Expanding="ExpandApplication" Collapsed="CollapseApplication" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent">
                <Expander.HeaderTemplate><DataTemplate><Grid ColumnSpacing="12" MinHeight="{StaticResource ShouListRowHeight}" Padding="8,0" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,0.5"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /><ColumnDefinition Width="88" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selection.IsSelected, Mode=OneWay}" Tag="{Binding}" Click="ToggleApplication" IsEnabled="{Binding Selectable}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" MinWidth="0" />
                    <ContentControl Grid.Column="1" Tag="applications" Loaded="LoadRowIcon" VerticalAlignment="Center" /><StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{StaticResource ShouCatalogTextFontSize}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource ShouCaption}" TextTrimming="CharacterEllipsis" /></StackPanel><Border Grid.Column="3" Style="{StaticResource ShouStatusPill}"><TextBlock Text="{Binding Status}" FontSize="{StaticResource ShouCaptionFontSize}" /></Border><TextBlock Grid.Column="4" Text="{Binding RegisteredSize}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" /><FontIcon Grid.Column="5" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid></DataTemplate></Expander.HeaderTemplate>
            </Expander></DataTemplate></ListView.ItemTemplate></ListView>
            <StackPanel x:Name="EmptyContent" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><ContentControl Tag="applications" Loaded="LoadRowIcon" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyText" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center" /></StackPanel>
        </Grid>
        </Grid></Border>
            <ScrollViewer x:Name="Inspector" Visibility="Collapsed" Padding="16" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,1,0,0"><StackPanel Spacing="16">
                <Button x:Name="CloseInspectorButton" Click="CloseInspector" HorizontalAlignment="Right"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                <TextBlock x:Name="Details" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <ContentControl x:Name="UpdatesHost" HorizontalContentAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="InspectButton" Click="InspectUninstall" /><Button x:Name="AuthorizeButton" Click="AuthorizeApplication" Visibility="Collapsed" AutomationProperties.AutomationId="applications.authorize" /></StackPanel>
                <CheckBox x:Name="InstallerDataConsent" Click="ChangeInstallerDataConsent"><TextBlock x:Name="InstallerDataDescription" TextWrapping="Wrap" /></CheckBox>
                <Button x:Name="ReadExecutionButton" Click="ReadUninstallExecution" />
                <TextBlock x:Name="UninstallStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
            </StackPanel></ScrollViewer>
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="12" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource ShouTitlebarBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock x:Name="SelectionSummary" AutomationProperties.AutomationId="applications.selection" VerticalAlignment="Center" /><TextBlock x:Name="FooterNotice" Style="{StaticResource ShouCaption}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" x:Name="PreviousButton" Click="Previous" VerticalAlignment="Center" /><Button Grid.Column="2" x:Name="NextButton" Click="Next" VerticalAlignment="Center" /><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"><Button x:Name="ClearSelectionButton" Click="ClearApplicationSelection" Visibility="Collapsed" /><Button x:Name="QuitSelectedButton" Click="QuitSelectedApplications" Visibility="Collapsed" /><Button x:Name="UninstallFooterButton" Click="ExecuteUninstall" AutomationProperties.AutomationId="applications.uninstall" IsEnabled="False" Style="{StaticResource ShouDestructiveButton}" VerticalAlignment="Center" /></StackPanel></Grid>
        <TextBlock x:Name="PageTitle" Visibility="Collapsed" />
    </Grid>
    </Grid>
</UserControl>
