<UserControl x:Class="Shou.Windows.App.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="PageToolbar" Orientation="Horizontal" Spacing="8"><Button x:Name="InfoButton" Style="{StaticResource ShouToolbarButton}"><FontIcon Glyph="&#xE946;" /><Button.Flyout><Flyout><TextBlock x:Name="Description" TextWrapping="Wrap" MaxWidth="360" /></Flyout></Button.Flyout></Button><Button x:Name="RefreshButton" Click="RefreshHistory" Style="{StaticResource ShouToolbarButton}" /><Button x:Name="CancelButton" Click="CancelOperation" Style="{StaticResource ShouToolbarButton}" /></StackPanel>
        <StackPanel><ProgressBar x:Name="Progress" Visibility="Collapsed" /><InfoBar x:Name="CoverageNotice" IsClosable="False" Severity="Warning" /><TextBlock x:Name="Status" Margin="20,8" TextWrapping="Wrap" Style="{StaticResource ShouCaption}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
        <Grid Grid.Row="1" Margin="16,0,16,0">
            <ListView x:Name="HistoryList" AutomationProperties.AutomationId="history.results" SelectionMode="Single" ItemContainerStyle="{StaticResource ShouTableItem}"><ListView.ItemTemplate><DataTemplate><Expander Style="{StaticResource ShouRowExpander}" Tag="{Binding}" Header="{Binding}" Expanding="ExpandExecution" Collapsed="CollapseExecution" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource ShouSurfaceBrush}" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0.5" CornerRadius="{StaticResource ShouCardRadius}" Margin="0,0,0,10" Padding="8,4"><Expander.HeaderTemplate><DataTemplate><Grid Padding="8,6" ColumnSpacing="12" AutomationProperties.Name="{Binding AccessibleName}"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ContentControl Loaded="LoadRowIcon" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontFamily="Consolas" /><TextBlock Text="{Binding Meta}" Style="{StaticResource ShouCaption}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Count}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding Details}" Foreground="{ThemeResource ShouAccentBrush}" VerticalAlignment="Center" /></Grid></DataTemplate></Expander.HeaderTemplate></Expander></DataTemplate></ListView.ItemTemplate></ListView>
            <StackPanel x:Name="EmptyContent" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="32" Spacing="24"><ContentControl Loaded="LoadRowIcon" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyTitle" FontSize="{StaticResource ShouStartTitleSize}" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource ShouCaption}" /></StackPanel>
        </Grid>
            <Grid x:Name="Inspector" Visibility="Collapsed" Padding="16" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,1,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="InspectButton" Click="InspectLocations" /><Button x:Name="CloseInspectorButton" Click="CloseInspector"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button></StackPanel><ScrollViewer Grid.Row="1" Margin="0,16,0,0"><StackPanel x:Name="DetailRows" Spacing="16" /></ScrollViewer></Grid>
        <Button Grid.Row="2" x:Name="NextButton" Click="NextHistoryPage" HorizontalAlignment="Right" Margin="20,10" />
        <TextBlock x:Name="PageTitle" Visibility="Collapsed" />
    </Grid>
</UserControl>
