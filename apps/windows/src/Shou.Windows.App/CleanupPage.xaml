<UserControl
    x:Class="Shou.Windows.App.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource ShouPagePadding}" RowSpacing="{StaticResource ShouSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource ShouItemSpacing}">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Description" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="{StaticResource ShouItemSpacing}">
            <Grid ColumnSpacing="{StaticResource ShouItemSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Locations" HorizontalAlignment="Stretch" DisplayMemberPath="Path" />
                <Button Grid.Column="1" x:Name="DiscoverButton" Click="DiscoverLocations" />
                <Button Grid.Column="2" x:Name="RefreshButton" Click="RefreshLocations" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}">
                <Button x:Name="ScanAllButton" Click="ScanAllLocations" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="ScanButton" Click="ScanLocation" />
                <Button x:Name="CancelButton" Click="CancelOperation" />
            </StackPanel>
            <Grid ColumnSpacing="{StaticResource ShouItemSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AllResultsButton" Click="ShowAllResults" />
                <ComboBox Grid.Column="1" x:Name="CategoryFilter" HorizontalAlignment="Stretch" DisplayMemberPath="Title" />
                <ComboBox Grid.Column="2" x:Name="RuleFilter" HorizontalAlignment="Stretch" DisplayMemberPath="Title" />
                <TextBox Grid.Column="3" x:Name="SearchFilter" MaxLength="512" TextChanged="ChangeSearch" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}">
                <CheckBox x:Name="FilteredSelection" IsThreeState="True" Click="ChangeFilteredSelection" />
                <Button x:Name="RecommendedButton" Click="SelectRecommended" />
                <Button x:Name="ClearSelectionButton" Click="ClearSelection" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="{StaticResource ShouItemSpacing}">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="CoverageNotice" IsClosable="False" IsOpen="False" Severity="Warning" />
            <TextBlock x:Name="BatchSummary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ListView Grid.Row="3" x:Name="Candidates" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Tag="{Binding Id}" IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Selectable}" Click="ChangeSelection" AutomationProperties.Name="{Binding Path}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}" />
                            <TextBlock Text="{Binding RuleName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        <StackPanel Grid.Row="4" Spacing="{StaticResource ShouItemSpacing}">
            <TextBlock x:Name="UnavailableNotice" TextWrapping="Wrap" />
            <Grid ColumnSpacing="{StaticResource ShouItemSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectedCount" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" x:Name="PreviousButton" Click="PreviousPage" />
                <Button Grid.Column="2" x:Name="NextButton" Click="NextPage" />
                <Button Grid.Column="3" x:Name="ReviewButton" Click="ReviewSelection" />
                <Button Grid.Column="4" x:Name="CleanButton" Click="ExecuteCleanup" IsEnabled="False" />
            </Grid>
            <Button x:Name="ReadExecutionButton" Click="ReadExecution" />
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ExecutionDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>
