<UserControl
    x:Class="Shou.Windows.App.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource ShouPagePadding}" Spacing="{StaticResource ShouSectionSpacing}">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Description" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}">
                <Button x:Name="ImportButton" Click="ImportRule" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="RefreshButton" Click="RefreshConfiguration" />
            </StackPanel>
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Spacing="{StaticResource ShouItemSpacing}">
                <TextBlock x:Name="RulesHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="Rules" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectionChanged="SelectRule" />
                <TextBlock x:Name="RuleDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBlock x:Name="BindingStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}">
                    <Button x:Name="EnableButton" Click="EnableRule" />
                    <Button x:Name="DisableButton" Click="DisableRule" />
                </StackPanel>
            </StackPanel>
            <StackPanel Spacing="{StaticResource ShouItemSpacing}">
                <TextBlock x:Name="LocationsHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="Locations" HorizontalAlignment="Stretch" DisplayMemberPath="Path" SelectionChanged="SelectLocation" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}">
                    <Button x:Name="AddLocationButton" Click="AddLocation" />
                    <Button x:Name="RemoveLocationButton" Click="RemoveLocation" />
                </StackPanel>
                <TextBlock x:Name="LocationsNotice" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource ShouItemSpacing}">
                <TextBlock x:Name="ExclusionsHeading" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="ExclusionScope" HorizontalAlignment="Stretch" SelectionChanged="ChangeExclusionScope" />
                <TextBlock x:Name="ExclusionsNotice" TextWrapping="Wrap" />
                <TextBlock x:Name="InheritedProtections" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <TextBox x:Name="ProjectPath" />
                <TextBox x:Name="ExclusionPattern" />
                <Button x:Name="AddExclusionButton" Click="AddExclusion" />
                <ListView x:Name="Exclusions" MaxHeight="220" SelectionMode="Single" SelectionChanged="SelectExclusion" />
                <Button x:Name="RemoveExclusionButton" Click="RemoveExclusion" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
