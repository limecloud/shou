<UserControl
    x:Class="Shou.Windows.App.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource ShouPagePadding}" RowSpacing="{StaticResource ShouSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource ShouItemSpacing}">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Description" TextWrapping="Wrap" />
            <TextBlock x:Name="ReadOnlyNotice" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}">
            <ComboBox x:Name="RangeBox" DisplayMemberPath="Label" SelectionChanged="RangeChanged" MinWidth="160" />
            <Button x:Name="ScanButton" Click="ScanSources" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="StopButton" Click="StopScan" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="{StaticResource ShouItemSpacing}">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="Boundaries" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <InfoBar Grid.Row="3" x:Name="CoverageNotice" IsClosable="False" IsOpen="False" Severity="Warning" />
        <ListView Grid.Row="4" x:Name="Sources" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8,10" Spacing="{StaticResource ShouItemSpacing}" AutomationProperties.Name="{Binding Title}">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
