<UserControl x:Class="Shou.Windows.App.PrivacyPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Shou.Windows.App">
    <Grid x:Name="PageLayout">
        <StackPanel x:Name="PageToolbar" Orientation="Horizontal" Spacing="8">
            <Button x:Name="InfoButton" Style="{StaticResource ShouToolbarButton}"><FontIcon Glyph="&#xE946;" /><Button.Flyout><Flyout><TextBlock x:Name="Description" MaxWidth="360" TextWrapping="Wrap" /></Flyout></Button.Flyout></Button>
            <Button x:Name="ScanButton" AutomationProperties.AutomationId="privacy.scan" Click="ScanSources" Style="{StaticResource ShouBorderedButton}" />
            <Button x:Name="StopButton" Click="StopScan" Style="{StaticResource ShouToolbarButton}" />
        </StackPanel>
        <Grid x:Name="ReviewContent" Padding="{StaticResource ShouPrivacyPagePadding}" RowSpacing="{StaticResource ShouPrivacySpacing}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="PageNotice" FontSize="{StaticResource ShouCatalogTextFontSize}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><TextBlock x:Name="RangeLabel" VerticalAlignment="Center" /><ComboBox x:Name="RangeBox" AutomationProperties.AutomationId="privacy.range" DisplayMemberPath="Label" SelectionChanged="RangeChanged" Width="240" /><TextBlock x:Name="RangeNotice" Style="{StaticResource ShouCaption}" VerticalAlignment="Center" /></StackPanel>
            <StackPanel Grid.Row="2" Spacing="4">
                <InfoBar x:Name="CoverageNotice" IsClosable="False" Severity="Warning" /><InfoBar x:Name="FailureNotice" IsClosable="False" Severity="Error" />
                <TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource ShouCaption}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="Boundaries" TextWrapping="Wrap" Style="{StaticResource ShouCaption}" />
            </StackPanel>
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="LandingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><StackPanel x:Name="StartContent" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Spacing="16" Margin="32"><ContentControl x:Name="StartIcon" HorizontalAlignment="Center" /><TextBlock x:Name="PageTitle" FontSize="{StaticResource ShouStartTitleSize}" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="StartDescription" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button x:Name="StartButton" AutomationProperties.AutomationId="privacy.start" Visibility="Collapsed" Click="ScanSources" Style="{StaticResource ShouPrimaryButton}" HorizontalAlignment="Center" /></StackPanel></ScrollViewer>
                <Border x:Name="SourcesCard" Style="{StaticResource ShouCatalogCard}" Visibility="Collapsed">
                    <ListView x:Name="Sources" AutomationProperties.AutomationId="privacy.sources" SelectionMode="None" ItemContainerStyle="{StaticResource ShouPrivacySourceItem}">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Padding="{StaticResource ShouPrivacyRowPadding}" ColumnSpacing="{StaticResource ShouPrivacySpacing}" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="{StaticResource ShouPrivacyIconWidth}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="{StaticResource ShouPrivacyStatusWidth}" /></Grid.ColumnDefinitions>
                                <CheckBox Tag="{Binding}" IsEnabled="{Binding Selectable}" IsChecked="{Binding Selected, Mode=OneWay}" AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.AutomationId="{Binding AutomationId}" Click="ToggleSource" VerticalAlignment="Center" />
                                <ContentControl Grid.Column="1" Content="{Binding Icon}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Kind}" Style="{StaticResource ShouCaption}" /></StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Count}" VerticalAlignment="Center" FontFamily="Consolas" />
                                <TextBlock Grid.Column="4" Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ShouCaption}" />
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
            <StackPanel Grid.Row="4" x:Name="SelectionFooter" Spacing="{StaticResource ShouPrivacySpacing}" Visibility="Collapsed">
                <CheckBox x:Name="CookieReview" AutomationProperties.AutomationId="privacy.cookie-consent" Click="ChangeCookieReview"><TextBlock x:Name="CookieReviewLabel" TextWrapping="Wrap" /></CheckBox>
                <Grid ColumnSpacing="{StaticResource ShouPrivacySpacing}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionSummary" AutomationProperties.AutomationId="privacy.selection" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" x:Name="ClearSelectionButton" AutomationProperties.AutomationId="privacy.clear" Click="ClearSelection" Style="{StaticResource ShouBorderedButton}" />
                    <Button Grid.Column="2" x:Name="RemoveButton" AutomationProperties.AutomationId="privacy.remove" Click="RemoveSources" Style="{StaticResource ShouPrimaryButton}" />
                </Grid>
            </StackPanel>
            <Border Grid.Row="5" x:Name="ReceiptCard" Style="{StaticResource ShouCatalogCard}" Padding="{StaticResource ShouPrivacyPagePadding}" Visibility="Collapsed">
                <StackPanel Spacing="8"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ReceiptTitle" FontWeight="Medium" VerticalAlignment="Center" /><Button Grid.Column="1" x:Name="ReadReceiptButton" AutomationProperties.AutomationId="privacy.read" Click="ReadReceipt" Style="{StaticResource ShouBorderedButton}" /></Grid>
                    <ListView x:Name="ReceiptItems" AutomationProperties.AutomationId="privacy.receipt" SelectionMode="None" MaxHeight="180" ItemContainerStyle="{StaticResource ShouPrivacySourceItem}"><ListView.ItemTemplate><DataTemplate><Grid ColumnSpacing="12" Padding="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding SourceId}" TextTrimming="CharacterEllipsis" Style="{StaticResource ShouMonoCaption}" /><TextBlock Grid.Column="1" Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource ShouCaption}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="6" Spacing="{StaticResource ShouPrivacySpacing}">
                <StackPanel x:Name="HistorySection" Visibility="Collapsed" Spacing="8">
                    <Button x:Name="HistoryToggle" AutomationProperties.AutomationId="privacy.history.toggle" Click="ToggleHistory" Style="{StaticResource ShouToolbarButton}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="HistoryDisclosure" Style="{StaticResource ShouCaption}" VerticalAlignment="Center" /><TextBlock x:Name="HistoryHeading" /></StackPanel></Button>
                    <ListView x:Name="HistoryItems" AutomationProperties.AutomationId="privacy.history" SelectionMode="None" MaxHeight="180" Visibility="Collapsed" ItemContainerStyle="{StaticResource ShouPrivacySourceItem}"><ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="0,4"><TextBlock Text="{Binding Title}" Style="{StaticResource ShouCaption}" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource ShouMonoCaption}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                </StackPanel>
                <InfoBar x:Name="HistoryFailure" IsClosable="False" Severity="Warning" />
                <TextBlock x:Name="CoverageFootnote" Style="{StaticResource ShouCaption}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        <local:OperationProgressView x:Name="ScanActivity" StopAutomationId="privacy.stop" StopClicked="StopScan" />
    </Grid>
</UserControl>
