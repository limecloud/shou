<UserControl
    x:Class="Shou.Windows.App.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource ShouPagePadding}" RowSpacing="{StaticResource ShouSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="{StaticResource ShouItemSpacing}">
            <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Description" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="{StaticResource ShouItemSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" MaxLength="256" TextChanged="FilterChanged" />
            <ComboBox Grid.Column="1" x:Name="SourceBox" DisplayMemberPath="Label" SelectionChanged="SourceChanged" />
            <Button Grid.Column="2" x:Name="RefreshButton" Click="Refresh" />
            <Button Grid.Column="3" x:Name="CancelButton" Click="Stop" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="{StaticResource ShouItemSpacing}">
            <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />
            <InfoBar x:Name="CoverageNotice" IsClosable="False" IsOpen="False" Severity="Warning" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="PreviousNotice" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="CoverageText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="{StaticResource ShouPageSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="Registrations" SelectionMode="Single" SelectionChanged="SelectRegistration">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,10" Spacing="{StaticResource ShouItemSpacing}" AutomationProperties.Name="{Binding Name}">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SourceLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Target}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource ShouSectionSpacing}">
                    <TextBlock x:Name="StateNotice" TextWrapping="Wrap" />
                    <TextBlock x:Name="Details" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource ShouItemSpacing}">
                        <Button x:Name="ReviewEnableButton" Tag="enable" Click="ReviewControl" />
                        <Button x:Name="ReviewDisableButton" Tag="disable" Click="ReviewControl" />
                    </StackPanel>
                    <Button x:Name="ApplyControlButton" Click="ApplyControl" />
                    <Button x:Name="StopControlButton" Click="StopControl" />
                    <Button x:Name="ReadControlButton" Click="ReadControl" />
                    <TextBlock x:Name="ControlStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource ShouItemSpacing}">
            <Button x:Name="PreviousButton" Click="Previous" />
            <Button x:Name="NextButton" Click="Next" />
        </StackPanel>
    </Grid>
</UserControl>
