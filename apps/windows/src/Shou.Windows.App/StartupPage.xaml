<UserControl x:Class="Shou.Windows.App.StartupPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentControl x:Name="LandingHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    <Grid x:Name="PageLayout">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel x:Name="PageToolbar" Orientation="Horizontal" Spacing="8"><Button x:Name="InfoButton" Style="{StaticResource ShouToolbarButton}"><FontIcon Glyph="&#xE946;" /><Button.Flyout><Flyout><ScrollViewer MaxHeight="480"><StackPanel Width="400" Spacing="12"><TextBlock x:Name="Description" TextWrapping="Wrap" /><InfoBar x:Name="CoverageNotice" IsClosable="False" Severity="Warning" /><TextBlock x:Name="StateNotice" TextWrapping="Wrap" /><TextBlock x:Name="FooterNotice" TextWrapping="Wrap" Style="{StaticResource ShouCaption}" VerticalAlignment="Center" /><ComboBox x:Name="SourceBox" DisplayMemberPath="Label" SelectionChanged="SourceChanged" HorizontalAlignment="Stretch" /><TextBlock x:Name="CoverageText" TextWrapping="Wrap" Style="{StaticResource ShouCaption}" /></StackPanel></ScrollViewer></Flyout></Button.Flyout></Button><Button x:Name="RefreshButton" Click="Refresh" Style="{StaticResource ShouToolbarButton}" /><Button x:Name="CancelButton" Click="Stop" Style="{StaticResource ShouToolbarButton}" /></StackPanel>
        <Border Grid.Row="0" Margin="20,0,20,10" Style="{StaticResource ShouCatalogCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="0">
            <Grid Padding="14" ColumnSpacing="10" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="SummaryText" FontWeight="Medium" FontSize="{StaticResource ShouCatalogTextFontSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="EnabledLabel" Style="{StaticResource ShouCaption}" VerticalAlignment="Center" /><TextBlock x:Name="EnabledCount" FontWeight="SemiBold" FontSize="{StaticResource ShouSummaryFigureSize}" Foreground="{ThemeResource ShouAccentBrush}" VerticalAlignment="Center" /></StackPanel><HyperlinkButton Grid.Column="1" x:Name="CoverageButton" Style="{StaticResource ShouLinkButton}" FontSize="{StaticResource ShouCaptionFontSize}" MinHeight="0" MinWidth="0" VerticalAlignment="Center" Click="ShowCoverage" Visibility="Collapsed" AutomationProperties.AutomationId="startup.coverage"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7BA;" FontSize="10" /><TextBlock x:Name="CoverageLabel" /></StackPanel></HyperlinkButton></Grid>
            <Grid Padding="10" ColumnSpacing="12" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4"><ToggleButton x:Name="FilterAll" Tag="all" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /><ToggleButton x:Name="FilterEnabled" Tag="enabled" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /><ToggleButton x:Name="FilterDisabled" Tag="disabled" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /><ToggleButton x:Name="FilterUnknown" Tag="unknown" Style="{StaticResource ShouFilterPill}" Click="ChangePresentationFilter" /></StackPanel>
                <TextBox Grid.Column="1" x:Name="SearchBox" AutomationProperties.AutomationId="startup.search" MaxLength="256" TextChanged="FilterChanged" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1"><ProgressBar x:Name="Progress" Visibility="Collapsed" /><TextBlock x:Name="Status" AutomationProperties.AutomationId="startup.status" Margin="20,0,20,8" Style="{StaticResource ShouCaption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="PreviousNotice" Margin="20,0,20,8" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel>
        <Grid Grid.Row="2">
            <ListView x:Name="Registrations" AutomationProperties.AutomationId="startup.results" SelectionMode="Single" SelectionChanged="SelectRegistration" ItemContainerStyle="{StaticResource ShouTableItem}"><ListView.ItemTemplate><DataTemplate><Expander Style="{StaticResource ShouRowExpander}" Tag="{Binding}" Header="{Binding}" Expanding="ExpandRegistration" Collapsed="CollapseRegistration" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent"><Expander.HeaderTemplate><DataTemplate>
                <StackPanel><TextBlock Text="{Binding GroupTitle}" Visibility="{Binding GroupVisibility}" Style="{StaticResource ShouCaption}" Margin="8,8,8,0" /><Grid MinHeight="{StaticResource ShouStartupRowHeight}" ColumnSpacing="12" Padding="8,0" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions><ContentControl Loaded="LoadRowIcon" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" FontSize="{StaticResource ShouCatalogTextFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource ShouStatusPill}" MaxWidth="180"><TextBlock Text="{Binding SourceLabel}" FontSize="{StaticResource ShouCaptionFontSize}" TextTrimming="CharacterEllipsis" /></Border><ToggleButton Grid.Column="3" Style="{StaticResource ShouSwitch}" IsChecked="{Binding TaskEnabled, Mode=OneWay}" IsEnabled="{Binding CanReviewSwitch}" Tag="{Binding}" Click="ToggleStartup" Visibility="{Binding TaskVisibility}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" /><FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /></Grid></StackPanel>
            </DataTemplate></Expander.HeaderTemplate></Expander></DataTemplate></ListView.ItemTemplate></ListView>
            <StackPanel x:Name="EmptyContent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed"><ContentControl Loaded="LoadRowIcon" HorizontalAlignment="Center" /><TextBlock x:Name="EmptyText" MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
        </Grid>
        </Grid></Border>
            <ScrollViewer x:Name="Inspector" Visibility="Collapsed" Padding="16" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,1,0,0"><StackPanel Spacing="16"><Button x:Name="CloseInspectorButton" Click="CloseInspector" HorizontalAlignment="Right"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button><TextBlock x:Name="Details" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><StackPanel Spacing="8"><Button x:Name="ReviewEnableButton" Tag="enable" Click="ReviewControl" /><Button x:Name="ReviewDisableButton" Tag="disable" Click="ReviewControl" /></StackPanel><Button x:Name="ApplyControlButton" Click="ApplyControl" /><Button x:Name="StopControlButton" Click="StopControl" /><Button x:Name="ReadControlButton" Click="ReadControl" /><TextBlock x:Name="ControlStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" /></StackPanel></ScrollViewer>
        <Grid x:Name="PaginationFooter" Grid.Row="1" Padding="20,10" BorderBrush="{ThemeResource ShouDividerBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="1" x:Name="PreviousButton" Click="Previous" Margin="0,0,8,0" /><Button Grid.Column="2" x:Name="NextButton" Click="Next" /></Grid>
        <TextBlock x:Name="PageTitle" Visibility="Collapsed" />
    </Grid>
    </Grid>
</UserControl>
