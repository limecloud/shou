            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource ShouAccent}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource ShouAccent}" />
