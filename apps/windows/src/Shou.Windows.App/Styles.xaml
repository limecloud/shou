            <SolidColorBrush x:Key="ShouRuleBannerBrush" Color="{StaticResource ShouRuleBannerDark}" />
            <SolidColorBrush x:Key="ShouCanvasBrush" Color="{StaticResource ShouCanvasDark}" />
            <SolidColorBrush x:Key="ShouSidebarBrush" Color="{StaticResource ShouSidebarDark}" />
