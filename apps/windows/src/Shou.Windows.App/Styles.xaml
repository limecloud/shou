            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource ShouTextSecondaryDark}" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource ShouSuccessDark}" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource ShouWarningDark}" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource ShouDangerFillDark}" />
