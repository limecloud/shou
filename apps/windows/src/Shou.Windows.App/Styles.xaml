            <SolidColorBrush x:Key="ShouNavHoverBrush" Color="{StaticResource ShouNavHoverDark}" />
            <SolidColorBrush x:Key="ShouNavSelectionBrush" Color="{StaticResource ShouNavSelectionDark}" />
            <SolidColorBrush x:Key="ShouNavPillBrush" Color="{StaticResource ShouNavPillDark}" />
            <SolidColorBrush x:Key="ShouLinkBrush" Color="{StaticResource ShouLinkDark}" />
            <SolidColorBrush x:Key="ShouFilterTextBrush" Color="{StaticResource ShouAccentDark}" />
            <SolidColorBrush x:Key="ShouMapBrush" Color="{StaticResource ShouMapSurface}" />
            <SolidColorBrush x:Key="ShouMapTextBrush" Color="{StaticResource ShouMapText}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShouTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShouSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShouDestructiveBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ShouDestructiveTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ShouActionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ShouActionTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ShouWorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouSwitchOffBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouRuleBannerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouSidebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouCleanupCategorySelectionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ShouTitlebarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouTableStripeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouSettingsBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ShouDividerBrush" Color="{ThemeResource SystemColorWindowColor}" />
