            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ShouNavSelectionDark}" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource ShouDividerDark}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ShouTextDark}" />
            <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource ShouSurfaceDark}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ShouTextDark}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource ShouDividerDark}" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource ShouAccentDark}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource ShouSurfaceDark}" />
            <SolidColorBrush x:Key="ShouDestructiveBackgroundBrush" Color="{StaticResource ShouDangerFillDark}" />
            <SolidColorBrush x:Key="ShouDestructiveTextBrush" Color="{StaticResource ShouTextLight}" />
            <LinearGradientBrush x:Key="ShouActionBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{StaticResource ShouActionStart}" Offset="0" /><GradientStop Color="{StaticResource ShouActionEnd}" Offset="1" /></LinearGradientBrush>
