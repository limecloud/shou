{
  "$schema": "../../packages/shou-contracts/rule.schema.json",
  "schema_version": "1.0",
  "id": "dev.rust-target",
  "version": "0.1.0",
  "name": "闲置 Rust 项目的 target 目录",
  "description": "在明确授权的开发工作区中，查找父目录含 Cargo.toml 且满足保留条件的 target 目录。",
  "platforms": ["macos"],
  "scope": {
    "root_ref": "developer-workspaces",
    "max_depth": 8,
    "follow_symlinks": false,
    "cross_filesystems": false
  },
  "match": {
    "kind": "directory",
    "relative_patterns": ["**/target"],
    "project_markers": {"location": "parent", "all_of": ["Cargo.toml"]}
  },
  "conditions": {
    "min_allocated_bytes": 104857600,
    "newest_descendant_modified_days_at_least": 14
  },
  "exclude": {"relative_patterns": ["active-project/**", "**/.git/**"]},
  "risk": {
    "declared_level": "review",
    "rebuild_note": "通常可由 cargo build 重新生成，但需要源文件、工具链和可用依赖；重新构建可能耗时。",
    "limitations": [
      "未使用自定义 CARGO_TARGET_DIR；存在此配置时需单独审阅。",
      "修改时间不能证明目录未被使用或所有内容可重建。",
      "如目录内保存了手工文件、交付物或不可重建内容，请排除。"
    ]
  },
  "action": {"type": "trash"}
}
